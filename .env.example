# Copy to .env for local, non-secret metadata. Never commit .env.
# SQLCL_CONNECTION_STRING must be supplied by the user for deploy and must
# never be committed. Prefer a saved SQLcl connection over a plaintext string.
SQLCL_CONNECTION_STRING=

# Metadata used by design and promotion reviews. This harness supports APEX 26.1
# and 26.2; the local sandbox is pinned to 26.2. Set TARGET_DB_VERSION only
# after confirming the commercial target; do not guess 19c, 23ai, or 26ai.
APEX_VERSION=26.2
TARGET_DB_VERSION=
