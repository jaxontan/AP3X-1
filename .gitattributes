* text=auto

# APEXLang parser requires LF. Never let Git convert .apx files on checkout.
*.apx text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf

# Windows scripts stay CRLF-friendly for PowerShell 5.1.
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
