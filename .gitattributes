* text=auto

# APEXLang parser requires LF. Never let Git convert .apx files on checkout.
*.apx text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf

# PowerShell 5.1 accepts LF; keep scripts stable across editors. cmd.exe needs CRLF.
*.ps1 text eol=lf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
