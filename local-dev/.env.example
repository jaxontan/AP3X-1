# Optional. Without local-dev/.env the sandbox uses the default Oracle123!.
# To use your own password, copy this file to local-dev/.env before the first
# docker compose up.
# Never commit .env. It is ignored by .gitignore.
#
# This password is used by the local sandbox only:
#   - SYS / SYSTEM / PDBADMIN in the database container
#   - ORDS_PUBLIC_USER
#   - APEX_PUBLIC_USER
#   - the APEX instance administrator ADMIN
#
# Use upper case, lower case, a digit, and a special character.
ORACLE_PASSWORD=Oracle123!
