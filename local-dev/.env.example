# Copy this file to local-dev/.env before running docker compose.
# Never commit .env. It is ignored by .gitignore.
#
# This password is used by the local sandbox only:
#   - SYS / SYSTEM / PDBADMIN in the database container
#   - ORDS_PUBLIC_USER
#   - APEX_PUBLIC_USER
#
# It does not create the APEX ADMIN user. Create that user after the first
# install with apxchpwd (see README.md, step 5).
#
# Use upper case, lower case, a digit, and a special character.
ORACLE_PASSWORD=Welcome123456#
