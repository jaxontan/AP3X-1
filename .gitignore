# Local toolchain (SQLcl is ~124 MB). Anchor to the repository root so the
# vendored APEXLang generation `tools/` directory is not ignored.
/tools/

# Dependencies
node_modules/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
cwallet.sso
ewallet.p12

# Local runtime state
.opencode/node_modules/
.opencode/*.local.*
.specify/feature.json
local-dev/uc-local-apex-dev/
snapshot_*.csv
promotion_audit_*.txt

# Editor and OS noise
.vscode/
.idea/
__pycache__/
*.pyc
*.log
.DS_Store
Thumbs.db
