lov venue-lov (
    name: VENUE_LOV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select venue_name || ' (' || hall_name || ' - ' || clear_height_m || 'm clear)' as d,
                   venue_id as r
            from fc_venue_profiles
            order by venue_id asc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

