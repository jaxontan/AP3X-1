lov planning-flags-lov (
    name: PLANNING_FLAGS_LOV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select severity || ' - ' || title as d, flag_id as r
            from fc_planning_flags
            where tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
            order by flag_id asc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

