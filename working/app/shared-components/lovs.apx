lov tender-lov (
    name: TENDER_LOV
    source {
        type: sqlQuery
        sqlQuery: select client_name || ' - ' || project_title || ' (' || tender_code || ')' as d, tender_id as r from fc_tenders order by tender_id desc
    }
    columnMapping {
        return: R
        display: D
    }
)

