lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov client-lov (
    name: CLIENT_LOV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select client_name as d, client_name as r
            from (
                select distinct client_name from fc_tenders where client_name is not null
                union
                select distinct client_name from fc_event_archives where client_name is not null
            )
            order by 1 asc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov concept-options-lov (
    name: CONCEPT_OPTIONS_LOV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select option_code || ': ' || concept_title as d, concept_id as r
            from fc_concept_options
            where tender_id = to_number(coalesce(:P3_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
            order by option_code asc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

