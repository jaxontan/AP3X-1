lov intake-criteria-lov (
    name: INTAKE_CRITERIA_LOV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select field_category || ' - ' || field_label || ': ' || substr(extracted_value, 1, 35) as d, field_id as r
            from fc_intake_fields
            where tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
            order by field_id asc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

