page 4 (
    name: Design & Spatial Studio
    alias: DESIGN-SPATIAL
    title: Design Studio - 3D Dimensions & Spatial Feasibility
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region design-handover-report (
        name: Design brief
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select handover_id,
                       initcap(replace(item_type, '_', ' ')) as item_type,
                       title || case when is_assumption = 'Y' then ' (assumption: confirm)' end as title,
                       description,
                       priority
                from fc_handover_items
                where tender_id = to_number(coalesce(:P4_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                  and target_team = 'DESIGN'
                order by case priority when 'HIGH' then 1 when 'NORMAL' then 2 else 3 end, handover_id
                ```
        }
        layout {
            sequence: 40
            parentRegion: @design-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DESCRIPTION (
            derivedColumn: N
            heading {
                heading: Details
            }
            layout {
                sequence: 4
            }
        )

        column HANDOVER_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column ITEM_TYPE (
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 2
            }
        )

        column PRIORITY (
            derivedColumn: N
            heading {
                heading: Priority
            }
            layout {
                sequence: 5
            }
        )

        column TITLE (
            derivedColumn: N
            heading {
                heading: Task
            }
            layout {
                sequence: 3
            }
        )

    )

    region design-tabs (
        name: Design Studio Workbench
        type: staticContent
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--fillLabels
                t-TabsRegion-mod--pill
