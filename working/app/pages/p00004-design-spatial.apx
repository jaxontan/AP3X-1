    process proc-resolve-collision (
        name: Auto-Mitigate Collision API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_tid   number := nvl(to_number(:P4_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                    l_names varchar2(2000);
                begin
                    -- Trim each structure that is too tall to 0.5 m under its venue's clear height.
                    -- Footprint failures need a redesign and are left as they are.
                    for r in (select s.structure_name, v.clear_height_m - 0.5 as new_h
                                from fc_spatial_checks s
                                join fc_venue_profiles v on v.venue_id = s.venue_id
                               where s.tender_id = l_tid
                                 and s.feasibility_status = 'FAIL'
                                 and s.req_height_m > v.clear_height_m) loop
                        fc_design_api.resolve_spatial_collision(
                            p_tender_id      => l_tid,
                            p_structure_name => r.structure_name,
                            p_new_height     => r.new_h,
                            p_user_name      => :APP_USER
                        );
                        l_names := l_names || case when l_names is not null then '; ' end || r.structure_name || ' to ' || to_char(r.new_h, 'FM990.0') || ' m';
                    end loop;
                    apex_application.g_print_success_message := case when l_names is null
                        then 'No height clashes to fix. Any remaining failures need a smaller footprint.'
                        else 'Height trimmed: ' || apex_escape.html(l_names) || '. Re-check the design with the client before Gate 2.' end;
                end;
                ```
        }
        execution {
            sequence: 25
        }
        advanced {
            executionMappingIdentifier: 41345236086949808
        }
        serverSideCondition {
            type: request=Value
            value: RESOLVE_COLLISION
        }
    )

