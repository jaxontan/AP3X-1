    region drawing-packages-report (
        name: Registered drawing packages
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select package_id,
                       version_num,
                       package_title,
                       drawing_url,
                       initcap(replace(approval_status, '_', ' ')) as approval_status,
                       is_current,
                       approved_by,
                       approved_at
                from fc_drawing_packages
                where tender_id = to_number(coalesce(:P4_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by package_id desc
                ```
