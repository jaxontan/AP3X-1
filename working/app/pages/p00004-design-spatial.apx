    process proc-spatial-engine (
        name: Execute 3D Spatial Collision Engine
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_tid    number := nvl(to_number(:P4_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                    l_status varchar2(20);
                    l_log    varchar2(2000);
                begin
                    if :P4_HGT is not null and :P4_VENUE_ID is not null then
                        -- Check the structure the designer entered against the chosen venue.
                        fc_design_api.run_spatial_check(
                            p_tender_id      => l_tid,
                            p_venue_id       => to_number(:P4_VENUE_ID),
                            p_structure_name => nvl(:P4_STRUCT_NAME, 'Main structure'),
                            p_len            => nvl(to_number(:P4_LEN), 0),
                            p_wid            => nvl(to_number(:P4_WID), 0),
                            p_hgt            => to_number(:P4_HGT),
                            p_user_name      => :APP_USER
                        );
                        select feasibility_status, assumptions_log into l_status, l_log
                          from fc_spatial_checks
                         where tender_id = l_tid
                         order by check_id desc
                         fetch first 1 row only;
                        apex_application.g_print_success_message := 'Fit check ' || l_status || ' for ' || apex_escape.html(nvl(:P4_STRUCT_NAME, 'the structure')) || '. ' || apex_escape.html(l_log)
                            || case when l_status = 'FAIL' then ' Gate 2 stays blocked until this is fixed.' end;
                    else
                        fc_design_api.generate_3d_specs(
                            p_tender_id => l_tid,
                            p_user_name => :APP_USER,
                            p_venue_id  => to_number(:P4_VENUE_ID)
                        );
                        apex_application.g_print_success_message := 'Standard structures checked against the venue. Enter a structure size above to check your own design.';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 8
        }
        advanced {
            executionMappingIdentifier: 40909230294205872
        }
        serverSideCondition {
            type: request=Value
            value: RUN_SPATIAL_ENGINE
        }
    )

    process proc-upload-package (
        name: Execute Upload Drawing Package API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_pkg_id number;
                    l_title varchar2(250) := :P4_PKG_TITLE;
                begin
                    if :P4_DRAWING_FILE is not null then
                        begin
                            select filename into l_title
                              from apex_application_temp_files
                             where name = :P4_DRAWING_FILE;
                        exception
                            when others then null;
                        end;
                    end if;
                    l_title := coalesce(l_title, :P4_PKG_TITLE, 'NYP_InnovSphere_Stage_and_Pods_3D.dwg');

                    fc_design_api.upload_drawing_package(
                        p_tender_id => nvl(to_number(:P4_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)),
                        p_title => l_title,
                        p_version => nvl(to_number(:P4_PKG_VER), 1.0),
                        p_user_name => :APP_USER,
                        x_package_id => l_pkg_id
                    );
                    apex_application.g_print_success_message := 'Drawing Package uploaded & registered! Drawing ID: ' || l_pkg_id || ' (' || l_title || ', v' || nvl(:P4_PKG_VER, '1.0') || ' ACTIVE) in /03_3D_Sketches/. Downstream BOQ items marked STALE (BR-06 cascade).';
                end;
                ```
        }
