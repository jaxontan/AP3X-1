    process init-page-tender (
        name: Initialize Page Tender Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P4_TENDER_ID is null then
                    :P4_TENDER_ID := to_char(fc_workflow_api.get_active_project(:APP_USER));
                    if :P4_TENDER_ID is not null then
                        fc_workflow_api.set_active_project(to_number(:P4_TENDER_ID), :APP_USER);
                    end if;
                else
                    fc_workflow_api.set_active_project(to_number(:P4_TENDER_ID), :APP_USER);
                end if;
                declare
                    l_tid number := nvl(to_number(:P4_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                begin
                    if l_tid = 1 then
                        :P4_VENUE_ID := '1';
                    elsif l_tid = 4 then
                        :P4_VENUE_ID := '4';
                    elsif l_tid = 2 then
                        :P4_VENUE_ID := '2';
                    else
                        :P4_VENUE_ID := '21';
                    end if;
                end;
                for t in (select tender_code || ' · ' || client_name as label
                            from fc_tenders
                           where tender_id = fc_workflow_api.get_active_project(:APP_USER)) loop
                    :FC_TENDER_LABEL := t.label;
                end loop;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40957946126652339
        }
    )

    process proc-approve-gate2 (
        name: Execute Approve Gate 2 API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                fc_design_api.approve_gate2(
                    p_tender_id => nvl(to_number(:P4_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)),
                    p_user_name => :APP_USER,
                    p_comments => :P4_GATE2_COMMENTS
                );
                apex_application.g_print_success_message := 'Gate 2 approved by ' || initcap(:APP_USER) || '. Handed over to Operations for costing.';
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 40909592077205872
        }
        serverSideCondition {
            type: request=Value
            value: APPROVE_GATE2
        }
        security {
            authorizationScheme: @designer-role
        }
    )

    process proc-export-deck (
        name: Export Pitch Deck (PPTX, HTML, PDF)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_tid  number := nvl(to_number(:P4_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                    l_file blob;
                    l_base varchar2(200);
                    l_name varchar2(250);
                    l_mime varchar2(100);
                begin
                    select regexp_replace(tender_code || '_' || client_name, '[^A-Za-z0-9-]+', '_')
                      into l_base
                      from fc_tenders
                     where tender_id = l_tid;

                    if :REQUEST = 'EXPORT_PPTX' then
                        l_file := fc_deck_api.build_pptx(l_tid);
                        l_name := l_base || '_Pitch_Deck.pptx';
                        l_mime := 'application/vnd.openxmlformats-officedocument.presentationml.presentation';
                    elsif :REQUEST = 'EXPORT_HTML' then
                        l_file := fc_deck_api.build_html(l_tid);
                        l_name := l_base || '_Presentation_Deck.html';
                        l_mime := 'text/html; charset=utf-8';
                    elsif :REQUEST = 'EXPORT_PDF' then
                        l_file := fc_deck_api.build_pdf(l_tid);
                        l_name := l_base || '_Pitch_Deck.pdf';
                        l_mime := 'application/pdf';
                    end if;

                    if l_file is not null then
                        sys.htp.init;
                        sys.owa_util.mime_header(l_mime, false);
                        sys.htp.p('Content-Length: ' || dbms_lob.getlength(l_file));
                        sys.htp.p('Content-Disposition: attachment; filename="' || l_name || '"');
                        sys.owa_util.http_header_close;
                        sys.wpg_docload.download_file(l_file);
                        apex_application.stop_apex_engine;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 2
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41078530133603064
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: EXPORT_PPTX:EXPORT_HTML:EXPORT_PDF
        }
    )

