app FLASH_PROPOSALS (
    name: Flash Concepts - AI Pitch & Proposal Workflow
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#icons/app-mark.svg
        text: Flash Concepts
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    javaScript {
        fileUrls: #APP_FILES#js/app.js?v=#APP_VERSION#
    }
    css {
        fileUrls: #APP_FILES#css/brand.css?v=#APP_VERSION#
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    sessionStateProtection {
        checksumSalt: BE8E26C19CF3511FBFEB1A6F9F79DA741A84B7ED70299369E025F6E56E2FFF65
    }
    errorHandling {
        defaultDisplayLocation: inlineInNotification
        errorHandlingFunctionName: fc_apex_error_handler
    }
    runtime {
        allowFeedback: true
    }
)

