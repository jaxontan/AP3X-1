page 1 (
    name: Pipeline Dashboard
    alias: DASHBOARD
    title: Flash Concepts - Proposal Workflow Command
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
