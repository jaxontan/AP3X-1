        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    button new-tender (
        buttonName: NEW_TENDER
        label: New tender
        layout {
            sequence: 10
            region: @actions-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-circle
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
            }
        }
    )

    button refresh-dashboard (
        buttonName: REFRESH_DASHBOARD
        label: Refresh
        layout {
            sequence: 20
            region: @actions-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
    )

    button view-financials (
        buttonName: VIEW_FINANCIALS
        label: Financials
        layout {
            sequence: 15
            region: @actions-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-line-chart
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
            }
        }
    )

    process get-explorer-data (
        name: GET_EXPLORER_DATA
        type: executeCode
        source {
            plsqlCode: htp.p(fc_planning_api.get_explorer_data_json);
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 40943034543885404
        }
    )

)

