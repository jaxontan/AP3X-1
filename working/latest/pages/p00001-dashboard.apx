            };
            
            let fcCurrentPath = ["2026", "11_November", "FC-2026-092"];
            let fcExpandedPaths = {
              "2026": true,
              "2026/11_November": true,
              "2026/11_November/FC-2026-092": true
            };
            
            function fcGetTarget(page, tenderId) {
              return "f?p=" + $v("pFlowId") + ":" + page + ":" + $v("pInstance") + "::::P" + page + "_TENDER_ID:" + tenderId;
            }
            
            let fcViewMode = "grid";
            
            function fcToggleTreeNode(path) {
              fcExpandedPaths[path] = !fcExpandedPaths[path];
              fcRenderSidebarTree();
            }
            
            function fcRenderSidebarTree() {
              var container = document.getElementById("fc-project-tree");
              if (!container) return;
            
              var curStr = fcCurrentPath.join("/");
              var html = "<div class=\"fc-tree-root\">";
            
              for (var y in FC_DATA) {
                var yExp = !!fcExpandedPaths[y];
                var yAct = curStr === y;
                html += "<div class=\"fc-tree-node\">" +
                  "<div class=\"fc-tree-row " + (yAct ? "fc-tree-row-active" : "") + "\" data-fc-path=\"" + y + "\">" +
                    "<div class=\"fc-tree-item-main\">" +
                      "<span class=\"fc-tree-toggle fa " + (yExp ? "fa-caret-down" : "fa-caret-right") + "\" data-fc-toggle=\"" + y + "\" title=\"" + (yExp ? "Collapse " + y : "Expand " + y) + "\"></span>" +
                      "<span class=\"fc-tree-icon fa " + (yExp ? "fa-folder-open" : "fa-folder") + "\"></span>" +
                      "<span class=\"fc-tree-label\">" + y + "</span>" +
                    "</div>" +
                  "</div>" +
                  "<div class=\"fc-tree-children " + (yExp ? "fc-expanded" : "") + "\">";
            
                var yData = FC_DATA[y];
                for (var m in yData) {
                  var mPath = y + "/" + m;
                  var mExp = !!fcExpandedPaths[mPath];
                  var mAct = curStr === mPath;
                  html += "<div class=\"fc-tree-node\">" +
                    "<div class=\"fc-tree-row " + (mAct ? "fc-tree-row-active" : "") + "\" data-fc-path=\"" + mPath + "\">" +
                      "<div class=\"fc-tree-item-main\">" +
                        "<span class=\"fc-tree-toggle fa " + (mExp ? "fa-caret-down" : "fa-caret-right") + "\" data-fc-toggle=\"" + mPath + "\" title=\"" + (mExp ? "Collapse " + m : "Expand " + m) + "\"></span>" +
                        "<span class=\"fc-tree-icon fa " + (mExp ? "fa-folder-open" : "fa-folder") + "\"></span>" +
                        "<span class=\"fc-tree-label\">" + m + "</span>" +
                      "</div>" +
                    "</div>" +
                    "<div class=\"fc-tree-children " + (mExp ? "fc-expanded" : "") + "\">";
            
                  var mData = yData[m];
                  for (var p in mData) {
                    var pPath = mPath + "/" + p;
                    var pExp = !!fcExpandedPaths[pPath];
                    var pAct = curStr === pPath;
                    var prj = mData[p];
                    var pIcon = prj.status === "DEAL_CLOSED" ? "fa-check-circle fc-tree-icon-won" : "fa-cube fc-tree-icon-project";
                    html += "<div class=\"fc-tree-node\">" +
                      "<div class=\"fc-tree-row " + (pAct ? "fc-tree-row-active" : "") + "\" data-fc-path=\"" + pPath + "\">" +
                        "<div class=\"fc-tree-item-main\">" +
                          "<span class=\"fc-tree-toggle fa " + (pExp ? "fa-caret-down" : "fa-caret-right") + "\" data-fc-toggle=\"" + pPath + "\" title=\"" + (pExp ? "Collapse " + p : "Expand " + p) + "\"></span>" +
                          "<span class=\"fc-tree-icon fa " + pIcon + "\"></span>" +
                          "<span class=\"fc-tree-label\" title=\"" + prj.title + "\">" + p + "</span>" +
                        "</div>" +
                      "</div>" +
                      "<div class=\"fc-tree-children " + (pExp ? "fc-expanded" : "") + "\">";
            
                    var stageFolders = ["01_Planning", "02_Designing", "03_Operations"];
                    for (var s = 0; s < stageFolders.length; s++) {
                      var sName = stageFolders[s];
                      var sPath = pPath + "/" + sName;
                      var sAct = curStr === sPath;
                      var sIcon = sName === "01_Planning" ? "fc-tree-icon-planning fa-pencil-square-o" :
                                 (sName === "02_Designing" ? "fc-tree-icon-designing fa-cube" : "fc-tree-icon-operations fa-calculator");
                      var fCount = (prj.folders && prj.folders[sName]) ? prj.folders[sName].length : 0;
            
                      html += "<div class=\"fc-tree-node\">" +
                        "<div class=\"fc-tree-row " + (sAct ? "fc-tree-row-active" : "") + "\" data-fc-path=\"" + sPath + "\">" +
                          "<div class=\"fc-tree-item-main\">" +
                            "<span class=\"fc-tree-spacer\" title=\"Non-expandable stage folder\"></span>" +
                            "<span class=\"fc-tree-icon fa " + sIcon + "\"></span>" +
                            "<span class=\"fc-tree-label\">" + sName + "</span>" +
                          "</div>" +
                          "<span class=\"fc-folder-count\">" + fCount + "</span>" +
                        "</div>" +
                      "</div>";
                    }
            
                    html += "</div></div>"; // close project
                  }
            
                  html += "</div></div>"; // close month
                }
            
                html += "</div></div>"; // close year
              }
            
              html += "</div>";
              container.innerHTML = html;
            }
            
            function fcNavigate(path) {
              fcCurrentPath = Array.isArray(path) ? path : [];
              var accum = [];
              for (var i = 0; i < fcCurrentPath.length; i++) {
                accum.push(fcCurrentPath[i]);
                fcExpandedPaths[accum.join("/")] = true;
              }
              fcRenderSidebarTree();
              fcRenderExplorer();
            
              var quickItems = document.querySelectorAll(".fc-sidebar-section .fc-folder-item");
              var cur = fcCurrentPath.join("/");
              for (var q = 0; q < quickItems.length; q++) {
                var qp = quickItems[q].getAttribute("data-fc-path");
                if (qp && qp === cur) {
                  quickItems[q].classList.add("fc-folder-item-active");
                } else if (qp) {
                  quickItems[q].classList.remove("fc-folder-item-active");
                }
              }
            }
            
            function fcNavigateUp() {
              if (fcCurrentPath.length > 0) {
                fcCurrentPath.pop();
                fcNavigate(fcCurrentPath);
              }
            }
            
            function fcOpenKanban() {
              var m = document.getElementById("fc-kanban-modal");
              if (m) { m.classList.add("fc-active"); }
            }
            
            function fcCloseKanban() {
              var m = document.getElementById("fc-kanban-modal");
              if (m) { m.classList.remove("fc-active"); }
            }
            
            function fcSetViewMode(mode) {
              fcViewMode = mode;
              var bGrid = document.querySelector('[data-fc-action="view-grid"]');
              var bList = document.querySelector('[data-fc-action="view-list"]');
              if (bGrid && bList) {
                if (mode === "grid") {
                  bGrid.classList.add("fc-view-mode-btn-active");
                  bList.classList.remove("fc-view-mode-btn-active");
                } else {
                  bList.classList.add("fc-view-mode-btn-active");
                  bGrid.classList.remove("fc-view-mode-btn-active");
                }
              }
              fcRenderExplorer();
            }
            
            function fcRenderExplorer() {
              var addrElem = document.getElementById("fc-address-path");
              if (addrElem) {
                var phtml = "<span class=\"fc-addr-pill\" data-fc-path=\"\">C:\\FlashConcepts\\Projects</span>";
                for (var a = 0; a < fcCurrentPath.length; a++) {
                  var subP = fcCurrentPath.slice(0, a + 1);
                  phtml += " <span class=\"fc-addr-sep\">\\</span> <span class=\"fc-addr-pill\" data-fc-path=\"" + subP.join("/") + "\">" + fcCurrentPath[a] + "</span>";
                }
                addrElem.innerHTML = phtml;
              }
            
              var breadcrumbElem = document.getElementById("fc-view-breadcrumb");
              if (breadcrumbElem) {
                var html = "<span class=\"fc-breadcrumb-link\" data-fc-path=\"\">Projects</span>";
                for (var i = 0; i < fcCurrentPath.length; i++) {
                  var sub = fcCurrentPath.slice(0, i + 1);
                  html += " &gt; <span class=\"fc-breadcrumb-link\" data-fc-path=\"" + sub.join("/") + "\">" + fcCurrentPath[i] + "</span>";
                }
                breadcrumbElem.innerHTML = "<span class=\"fa fa-folder-open\"></span> " + html;
              }
            
              var gridElem = document.getElementById("fc-explorer-grid");
              if (!gridElem) { return; }
            
              var itemsHtml = "";
              var depth = fcCurrentPath.length;
            
              if (depth === 0) {
                for (var y in FC_DATA) {
                  itemsHtml += "<div class=\"fc-folder-card\" data-fc-path=\"" + y + "\">" +
                               "<div class=\"fc-folder-icon-large\"><span class=\"fa fa-folder\"></span></div>" +
                               "<div class=\"fc-folder-name-large\">" + y + "</div>" +
                               "<div class=\"fc-folder-meta-large\">Project Archives &amp; Active Bids</div>" +
                               "</div>";
                }
              } else if (depth === 1) {
                var year = fcCurrentPath[0];
                var yearData = FC_DATA[year] || {};
                for (var m in yearData) {
                  itemsHtml += "<div class=\"fc-folder-card\" data-fc-path=\"" + year + "/" + m + "\">" +
                               "<div class=\"fc-folder-icon-large\"><span class=\"fa fa-folder\"></span></div>" +
                               "<div class=\"fc-folder-name-large\">" + m + "</div>" +
                               "<div class=\"fc-folder-meta-large\">Tenders for " + m + "</div>" +
                               "</div>";
                }
              } else if (depth === 2) {
                var y2 = fcCurrentPath[0];
                var m2 = fcCurrentPath[1];
                var monthData = (FC_DATA[y2] && FC_DATA[y2][m2]) || {};
                for (var p in monthData) {
                  var prj = monthData[p];
                  itemsHtml += "<div class=\"fc-folder-card\" data-fc-path=\"" + y2 + "/" + m2 + "/" + p + "\">" +
                               "<div class=\"fc-folder-icon-large\"><span class=\"fa fa-folder-open\"></span></div>" +
                               "<div class=\"fc-folder-name-large\">" + prj.name + "</div>" +
                               "<div class=\"fc-folder-meta-large\">" + prj.client + " &bull; <span class=\"fc-status-pill " + prj.statusClass + "\">" + prj.statusText + "</span></div>" +
                               "<a href=\"" + fcGetTarget(prj.page, prj.id) + "\" class=\"fc-file-btn fc-file-btn-primary fc-mt-sm\"><span class=\"fa fa-external-link\"></span> " + prj.stage + "</a>" +
                               "</div>";
                }
              } else if (depth === 3) {
                var y3 = fcCurrentPath[0];
                var m3 = fcCurrentPath[1];
                var p3 = fcCurrentPath[2];
                var prjData = (FC_DATA[y3] && FC_DATA[y3][m3] && FC_DATA[y3][m3][p3]);
                if (prjData) {
                  itemsHtml += "<div class=\"fc-project-strip\">" +
                    "<div>" +
                      "<div class=\"fc-strip-title\"><span class=\"fa fa-building-o\"></span> " + prjData.title + " <span class=\"fc-status-pill " + prjData.statusClass + "\">" + prjData.statusText + "</span></div>" +
                      "<div class=\"fc-strip-meta\"><span><span class=\"fa fa-institution\"></span> " + prjData.client + "</span><span><span class=\"fa fa-money\"></span> Value: " + (prjData.dealValue || "SGD 120,000.00") + "</span><span><span class=\"fa fa-calendar\"></span> Submission: 15-Nov-2026</span></div>" +
                    "</div>" +
                    "<div class=\"fc-strip-stepper\">" +
                      "<span class=\"fc-step-pill fc-step-pill-done\"><span class=\"fa fa-check\"></span> Step 1: Intake</span>" +
                      "<span class=\"fc-step-pill fc-step-pill-done\"><span class=\"fa fa-check\"></span> Step 2: Planning</span>" +
                      "<span class=\"fc-step-pill fc-step-pill-done\"><span class=\"fa fa-check\"></span> Step 3: Spatial</span>" +
                      "<span class=\"fc-step-pill fc-step-pill-active\"><span class=\"fa fa-dot-circle-o\"></span> Step 4: Costing</span>" +
                      "<span class=\"fc-step-pill\"><span class=\"fa fa-clock-o\"></span> Step 5: Release</span>" +
                    "</div>" +
                  "</div>";
            
                  var stageConfigs = {
                    "01_Planning": {
                      stepNum: "1",
                      circleClass: "fc-step-circle-1",
                      tagClass: "fc-tag-planning",
                      tagLabel: "STAGE 1 &bull; PLANNING",
                      heroClass: "fc-hero-planning",
                      icon: "fa-pencil-square-o",
                      desc: "Client Tender Briefs, AI Research Findings &amp; Pitch Decks",
                      ownerName: "Michelle Lee (Planning Lead)",
                      avatarClass: "fc-avatar-michelle",
                      avatarInit: "ML",
                      btnClass: "fc-btn-planning",
                      page: 3,
                      btnLabel: "Enter Planning Studio (Step 2) &rarr;"
                    },
                    "02_Designing": {
                      stepNum: "2",
                      circleClass: "fc-step-circle-2",
                      tagClass: "fc-tag-designing",
                      tagLabel: "STAGE 2 &bull; 3D SPATIAL",
                      heroClass: "fc-hero-designing",
                      icon: "fa-cube",
                      desc: "Campus AutoCAD Layouts, 3D Spatial Feasibility &amp; Key Visuals",
                      ownerName: "Adi Nugroho (Spatial Designer)",
                      avatarClass: "fc-avatar-adi",
                      avatarInit: "AD",
                      btnClass: "fc-btn-designing",
                      page: 4,
                      btnLabel: "Enter Spatial Studio (Step 3) &rarr;"
                    },
                    "03_Operations": {
                      stepNum: "3",
                      circleClass: "fc-step-circle-3",
                      tagClass: "fc-tag-operations",
                      tagLabel: "STAGE 3 &bull; COSTING &amp; BOQ",
                      heroClass: "fc-hero-operations",
                      icon: "fa-calculator",
                      desc: "Bill of Quantities (BOQ), Vendor Quotations &amp; Compliance Audits",
                      ownerName: "Wei Lin (Operations Lead)",
                      avatarClass: "fc-avatar-weilin",
                      avatarInit: "WL",
                      btnClass: "fc-btn-operations",
                      page: 5,
                      btnLabel: "Enter Costing Studio (Step 4) &rarr;"
                    }
                  };
            
                  for (var cat in prjData.folders) {
                    var files = prjData.folders[cat];
                    var cfg = stageConfigs[cat] || {
                      stepNum: "•",
                      circleClass: "fc-step-circle-1",
                      tagClass: "fc-tag-planning",
                      tagLabel: "DEPARTMENT FOLDER",
                      heroClass: "fc-hero-planning",
                      icon: "fa-folder",
                      desc: files.length + " document(s)",
                      ownerName: "Department Lead",
                      avatarClass: "fc-avatar-michelle",
                      avatarInit: "FC",
                      btnClass: "fc-btn-planning",
                      page: prjData.page,
                      btnLabel: prjData.stage
                    };
            
                    itemsHtml += "<div class=\"fc-stage-folder-card\" data-fc-path=\"" + y3 + "/" + m3 + "/" + p3 + "/" + cat + "\">" +
                      "<div class=\"fc-stage-folder-header\">" +
                        "<div class=\"fc-stage-badge-group\">" +
                          "<div class=\"fc-step-circle " + cfg.circleClass + "\">" + cfg.stepNum + "</div>" +
                          "<span class=\"fc-stage-tag " + cfg.tagClass + "\">" + cfg.tagLabel + "</span>" +
                        "</div>" +
                        "<span class=\"fc-folder-count\">" + files.length + " files</span>" +
                      "</div>" +
                      "<div class=\"fc-folder-hero-icon " + cfg.heroClass + "\"><span class=\"fa " + cfg.icon + "\"></span> <span class=\"fc-folder-name-large\">" + cat + "</span></div>" +
                      "<div class=\"fc-folder-meta-large\">" + files.length + " document(s) &bull; " + cfg.desc + "</div>" +
                      "<div class=\"fc-owner-pill\"><span class=\"fc-avatar " + cfg.avatarClass + "\">" + cfg.avatarInit + "</span> " + cfg.ownerName + "</div>" +
                      "<a href=\"" + fcGetTarget(cfg.page, prjData.id) + "\" class=\"fc-folder-action-btn " + cfg.btnClass + " fc-mt-sm\"><span class=\"fa fa-external-link\"></span> " + cfg.btnLabel + "</a>" +
                    "</div>";
                  }
                }
              } else if (depth >= 4) {
                var y4 = fcCurrentPath[0];
                var m4 = fcCurrentPath[1];
                var p4 = fcCurrentPath[2];
                var c4 = fcCurrentPath[3];
                var prjData4 = (FC_DATA[y4] && FC_DATA[y4][m4] && FC_DATA[y4][m4][p4]);
                var fileList = (prjData4 && prjData4.folders && prjData4.folders[c4]) || [];
            
                if (fcViewMode === "grid") {
                  for (var f4 = 0; f4 < fileList.length; f4++) {
                    var item = fileList[f4];
                    var avatarClass = item.author === "ADI" ? "fc-avatar-adi" : (item.author === "WEI_LIN" ? "fc-avatar-weilin" : "fc-avatar-michelle");
                    var initials = item.author === "ADI" ? "AD" : (item.author === "WEI_LIN" ? "WL" : "ML");
                    itemsHtml += "<div class=\"fc-file-card\">" +
                                 "<div class=\"fc-file-card-top\"><span class=\"fc-file-badge " + item.badgeClass + "\">" + item.badge + "</span><span class=\"fc-file-ver\">" + item.ver + "</span></div>" +
                                 "<div class=\"fc-file-name\">" + item.name + "</div>" +
                                 "<div class=\"fc-file-details\"><span>" + item.size + "</span><span class=\"fc-owner-pill\"><span class=\"fc-avatar " + avatarClass + "\">" + initials + "</span> " + item.author + "</span></div>" +
                                 "<div class=\"fc-file-actions\"><a href=\"" + fcGetTarget(item.page, prjData4.id) + "\" class=\"fc-file-btn fc-file-btn-primary\"><span class=\"fa fa-external-link\"></span> Open in Studio</a></div>" +
                                 "</div>";
                  }
                } else {
                  itemsHtml += "<table class=\"fc-details-table\"><thead><tr>" +
                    "<th class=\"fc-details-th\">Document Name</th>" +
                    "<th class=\"fc-details-th\">Type</th>" +
                    "<th class=\"fc-details-th\">Version</th>" +
                    "<th class=\"fc-details-th\">Size</th>" +
                    "<th class=\"fc-details-th\">Owner</th>" +
                    "<th class=\"fc-details-th\">Action</th>" +
                  "</tr></thead><tbody>";
                  for (var fi = 0; fi < fileList.length; fi++) {
                    var fRow = fileList[fi];
                    var aClass = fRow.author === "ADI" ? "fc-avatar-adi" : (fRow.author === "WEI_LIN" ? "fc-avatar-weilin" : "fc-avatar-michelle");
                    var aInit = fRow.author === "ADI" ? "AD" : (fRow.author === "WEI_LIN" ? "WL" : "ML");
                    itemsHtml += "<tr class=\"fc-details-row\">" +
                      "<td class=\"fc-details-td fc-details-td-name\"><span class=\"fa fa-file-text-o\"></span> " + fRow.name + "</td>" +
                      "<td class=\"fc-details-td\"><span class=\"fc-file-badge " + fRow.badgeClass + "\">" + fRow.badge + "</span></td>" +
                      "<td class=\"fc-details-td fc-details-td-muted\">" + fRow.ver + "</td>" +
                      "<td class=\"fc-details-td fc-details-td-muted\">" + fRow.size + "</td>" +
                      "<td class=\"fc-details-td\"><span class=\"fc-owner-pill\"><span class=\"fc-avatar " + aClass + "\">" + aInit + "</span> " + fRow.author + "</span></td>" +
                      "<td class=\"fc-details-td\"><a href=\"" + fcGetTarget(fRow.page, prjData4.id) + "\" class=\"fc-file-btn fc-file-btn-primary\"><span class=\"fa fa-external-link\"></span> Open in Studio</a></td>" +
                    "</tr>";
                  }
                  itemsHtml += "</tbody></table>";
                }
              }
            
              gridElem.innerHTML = itemsHtml;
            
              var statusCountElem = document.getElementById("fc-status-item-count");
              if (statusCountElem) {
                var countText = "";
                if (depth === 0) countText = Object.keys(FC_DATA).length + " year(s)";
                else if (depth === 1) countText = Object.keys(FC_DATA[fcCurrentPath[0]] || {}).length + " month(s)";
                else if (depth === 2) countText = Object.keys((FC_DATA[fcCurrentPath[0]] && FC_DATA[fcCurrentPath[0]][fcCurrentPath[1]]) || {}).length + " project(s)";
                else if (depth === 3) countText = "3 stage folders";
                else if (depth >= 4) {
                  var p4b = fcCurrentPath[2];
                  var c4b = fcCurrentPath[3];
                  var prjB = FC_DATA[fcCurrentPath[0]] && FC_DATA[fcCurrentPath[0]][fcCurrentPath[1]] && FC_DATA[fcCurrentPath[0]][fcCurrentPath[1]][p4b];
                  var flB = (prjB && prjB.folders && prjB.folders[c4b]) || [];
                  countText = flB.length + " document(s)";
                }
                statusCountElem.textContent = countText;
              }
              var statusPathElem = document.getElementById("fc-status-path-label");
              if (statusPathElem) {
                statusPathElem.textContent = fcCurrentPath.length === 0 ? "Projects Root" : fcCurrentPath.join(" \\ ");
              }
            }
            
            function fcFilterSearch(query) {
              if (!query) { fcRenderExplorer(); return; }
              var q = query.toLowerCase();
              var gridElem = document.getElementById("fc-explorer-grid");
              if (!gridElem) { return; }
              var cards = gridElem.children;
              for (var i = 0; i < cards.length; i++) {
                var text = cards[i].innerText.toLowerCase();
                cards[i].style.display = text.indexOf(q) !== -1 ? "" : "none";
              }
            }
            
            function fcRefreshFromDb() {
              if (typeof apex !== "undefined" && apex.server && apex.server.process) {
                apex.server.process("GET_EXPLORER_DATA", {}, {
                  dataType: "json",
                  success: function(pData) {
                    var data = typeof pData === "string" ? JSON.parse(pData) : pData;
                    if (data && typeof data === "object" && Object.keys(data).length > 0) {
                      FC_DATA = data;
                      fcRenderSidebarTree();
                      fcRenderExplorer();
                    }
                  },
                  error: function(jqXHR, textStatus, errorThrown) {
                    console.warn("GET_EXPLORER_DATA fallback to local cache:", errorThrown);
                  }
                });
              }
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            fcNavigate(["2026", "11_November", "FC-2026-092"]);
            fcRefreshFromDb();
            document.addEventListener("click", function(e) {
              var toggleElem = e.target.closest("[data-fc-toggle]");
              if (toggleElem) {
                e.stopPropagation();
                e.preventDefault();
                var tPath = toggleElem.getAttribute("data-fc-toggle");
                fcToggleTreeNode(tPath);
                return;
              }
              var actionElem = e.target.closest("[data-fc-action]");
              if (actionElem) {
                var act = actionElem.getAttribute("data-fc-action");
                if (act === "up") fcNavigateUp();
                else if (act === "root") { fcNavigate([]); fcRefreshFromDb(); }
                else if (act === "open-kanban") fcOpenKanban();
                else if (act === "close-kanban") fcCloseKanban();
                else if (act === "view-grid") fcSetViewMode("grid");
                else if (act === "view-list") fcSetViewMode("list");
              }
              var pathElem = e.target.closest("[data-fc-path]");
              if (pathElem) {
                var p = pathElem.getAttribute("data-fc-path");
                fcNavigate(p ? p.split("/") : []);
              }
            });
            var searchInput = document.getElementById("fc-search-input");
            if (searchInput) {
              searchInput.addEventListener("input", function(e) {
                fcFilterSearch(e.target.value);
              });
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region actions-bar (
        name: Pipeline Actions
        type: staticContent
        layout {
            sequence: 15
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

