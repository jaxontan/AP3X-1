    process proc-generate-concepts (
        name: Call Generate AI Concepts API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_ai number;
                begin
                    fc_planning_api.generate_concept_options(
                        p_tender_id => to_number(:P3_TENDER_ID),
                        p_user_name => :APP_USER
                    );
                    select count(*) into l_ai
                      from fc_concept_options
                     where tender_id = to_number(:P3_TENDER_ID) and generated_by = 'AI';
                    apex_application.g_print_success_message := case
                        when l_ai > 0 then l_ai || ' concept options generated by AI from the confirmed brief. Review them and select one.'
                        else 'The AI service is unavailable, so template concept options are shown. Check AI settings and try again.'
                    end;
                end;
                ```
        }
