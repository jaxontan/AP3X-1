    process ajax-get-concept-details (
        name: Fetch Concept Option Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_concept fc_concept_options%rowtype;
                begin
                    select * into l_concept
                      from fc_concept_options
                     where concept_id = to_number(apex_application.g_x01);
                    apex_json.open_object;
                    apex_json.write('concept_id', l_concept.concept_id);
                    apex_json.write('option_code', l_concept.option_code);
                    apex_json.write('title', l_concept.concept_title);
                    apex_json.write('narrative', l_concept.narrative);
                    apex_json.write('spatial', l_concept.spatial_notes);
                    apex_json.write('event_flow', l_concept.event_flow);
                    apex_json.close_object;
                exception
                    when no_data_found then
                        apex_json.open_object;
                        apex_json.write('error', 'Concept not found');
                        apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 50
            point: ajaxCallback
        }
        security {
            authorizationScheme: @planner-role
        }
    )

