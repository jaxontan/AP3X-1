page 3 (
    name: Planning Studio & Gate 1
    alias: PLANNING-STUDIO
    title: Planning Studio - Creative Ideation & Gate 1
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region citations-report (
        name: Research sources
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select finding_id,
                       topic,
                       claim_text,
                       source_url,
                       publisher,
                       confidence_score,
                       initcap(replace(review_status, '_', ' ')) as review_status
                from fc_research_findings
                where tender_id = to_number(coalesce(:P3_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by finding_id asc
                ```
        }
        layout {
            sequence: 15
            parentRegion: @planning-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CLAIM_TEXT (
            derivedColumn: N
            heading {
                heading: Corporate Strategic Mandate / Claim
            }
            layout {
                sequence: 3
            }
        )

        column CONFIDENCE_SCORE (
            derivedColumn: N
            heading {
                heading: Confidence (%)
            }
            layout {
                sequence: 6
            }
        )

        column FINDING_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column PUBLISHER (
            derivedColumn: N
            heading {
                heading: Publisher / Engine
            }
            layout {
                sequence: 5
            }
        )

        column REVIEW_STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 7
            }
        )

        column SOURCE_URL (
            derivedColumn: N
            heading {
                heading: Citation Source URL
            }
            layout {
                sequence: 4
            }
        )

        column TOPIC (
            derivedColumn: N
            heading {
                heading: Topic
            }
            layout {
                sequence: 2
            }
        )

    )

    region concepts-report (
        name: Concept options
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select concept_id,
                       option_code,
                       concept_title,
                       image_url,
                       image_prompt,
                       narrative,
                       brief_fit,
                       spatial_notes,
                       event_flow,
                       fringe_activities,
                       is_selected,
                       case when is_selected = 'Y' then 'Selected concept' else 'Option ' || option_code end as selection_label,
                       case when generated_by = 'AI' then 'AI draft' else 'Template' end as source_label,
                       case when is_selected = 'Y' then 'Selected as Hero' else 'Select as Hero' end as select_btn_label,
                       case when is_selected = 'Y' then 't-Button--success' else 't-Button--hot' end as select_btn_class,
                       case when is_selected = 'Y' then 'disabled' else '' end as select_btn_disabled
                from fc_concept_options
                where tender_id = to_number(coalesce(:P3_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by option_code asc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @planning-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            gridColumns: 3
            cssClasses: fc-concept-cards
        }
        card {
            cssClasses: [
                fc-concept-card
                fc-concept-card--&IS_SELECTED.
            ]
            primaryKeyColumn1: CONCEPT_ID
        }
        title {
            column: CONCEPT_TITLE
        }
        subtitle {
            advancedFormatting: true
            htmlExpression: <span class="fc-concept-tag fc-concept-tag--&IS_SELECTED.">&SELECTION_LABEL.</span> <span class="fc-concept-source">&SOURCE_LABEL.</span>
        }
        body {
            advancedFormatting: true
            htmlExpression: <p class="fc-concept-text">&NARRATIVE.</p><p class="fc-concept-label">Why it fits the brief</p><p class="fc-concept-text">&BRIEF_FIT.</p><p class="fc-concept-label">Space and clearance</p><p class="fc-concept-text">&SPATIAL_NOTES.</p>
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression: <p class="fc-concept-label">Run of show</p><p class="fc-concept-text fc-concept-pre">&EVENT_FLOW.</p><p class="fc-concept-label">Fringe activities</p><p class="fc-concept-text fc-concept-pre">&FRINGE_ACTIVITIES.</p>{if IMAGE_PROMPT/}<p class="fc-concept-label">Visual brief for the design team</p><p class="fc-concept-text fc-concept-visual">&IMAGE_PROMPT.</p>{endif/}<div class="fc-concept-card-actions"><button type="button" class="t-Button t-Button--small fc-btn-hero &SELECT_BTN_CLASS." onclick="selectConceptCard(&CONCEPT_ID., '&OPTION_CODE.');" &SELECT_BTN_DISABLED.><span class="fa fa-check-circle" aria-hidden="true"></span> <span class="t-Button-label">&SELECT_BTN_LABEL.</span></button><button type="button" class="t-Button t-Button--small fc-btn-edit-concept" onclick="openConceptEditModal(&CONCEPT_ID., '&OPTION_CODE.');"><span class="fa fa-pencil" aria-hidden="true"></span> <span class="t-Button-label">Edit Concept / Reprompt</span></button></div>
        }
        media {
            source: urlColumn
            urlColumn: IMAGE_URL
            position: first
            appearance: widescreen
            sizing: cover
            imageDescription: Scene visual for &CONCEPT_TITLE.
        }
    )

    region early-warning-flags-report (
        name: Venue and safety flags
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select flag_id,
                       initcap(replace(flag_category, '_', ' ')) as flag_category,
                       initcap(replace(severity, '_', ' ')) as severity,
                       case
                         when severity = 'CRITICAL' then '<span class="t-Badge t-Badge--danger t-Badge--large"><span class="fa fa-ban"></span> CRITICAL</span>'
                         when severity = 'WARNING' then '<span class="t-Badge t-Badge--warning t-Badge--large"><span class="fa fa-exclamation-triangle"></span> WARNING</span>'
                         else '<span class="t-Badge t-Badge--info t-Badge--large"><span class="fa fa-info-circle"></span> ' || severity || '</span>'
                       end as severity_badge,
                       title,
                       description,
                       recommended_mitigation,
                       initcap(replace(status, '_', ' ')) as status
                from fc_planning_flags
                where tender_id = to_number(coalesce(:P3_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by case fc_planning_flags.severity when 'CRITICAL' then 1 when 'WARNING' then 2 else 3 end, flag_id asc
                ```
        }
        layout {
            sequence: 12
            parentRegion: @planning-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DESCRIPTION (
            derivedColumn: N
            heading {
                heading: Statutory / Venue Impact
            }
            layout {
                sequence: 5
            }
        )

        column FLAG_CATEGORY (
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 2
            }
        )

        column FLAG_ID (
            derivedColumn: N
            heading {
                heading: Flag ID
            }
            layout {
                sequence: 1
            }
        )

        column RECOMMENDED_MITIGATION (
            derivedColumn: N
            heading {
                heading: Recommended Engineering Mitigation
            }
            layout {
                sequence: 6
            }
        )

        column SEVERITY_BADGE (
            derivedColumn: N
            heading {
                heading: Severity
            }
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 7
            }
        )

        column TITLE (
            derivedColumn: N
            heading {
                heading: Early Warning Constraint
            }
            layout {
                sequence: 4
            }
        )

    )

    region gate1-pending-banner (
        name: Gate 1 Pending Status
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--warning t-Alert--horizontal t-Alert--page">
                    <div class="t-Alert-wrap">
                        <div class="t-Alert-icon">
                            <span class="t-Icon fa fa-clock-o" aria-hidden="true"></span>
                        </div>
                        <div class="t-Alert-content">
                            <h2 class="t-Alert-title">GATE 1 PLANNING STATUS: IN REVIEW (PENDING MICHELLE SIGN-OFF)</h2>
                            <div class="t-Alert-body">Select a concept, check the team handover tasks, then click <strong>Approve Gate 1 and hand over</strong>.</div>
                        </div>
                        <div class="t-Alert-buttons">
                            <span class="t-Badge t-Badge--warning t-Badge--large">PENDING GATE 1</span>
                        </div>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 33
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: not fc_workflow_api.is_gate_approved(nvl(to_number(:P3_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)), 1)
        }
    )

    region gate1-status-banner (
        name: Gate 1 Approval Status
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--success t-Alert--horizontal t-Alert--page">
                    <div class="t-Alert-wrap">
                        <div class="t-Alert-icon">
                            <span class="t-Icon fa fa-check-circle" aria-hidden="true"></span>
                        </div>
                        <div class="t-Alert-content">
                            <h2 class="t-Alert-title">GATE 1 PLANNING STATUS: SIGNED OFF &amp; APPROVED</h2>
                            <div class="t-Alert-body">Signed off by Michelle (Planning Lead). Handover packages dispatched to Design Studio (Adi) &amp; Operations (Wei Lin).</div>
                        </div>
                        <div class="t-Alert-buttons">
                            <span class="t-Badge t-Badge--success t-Badge--large">STAGE 2: DESIGN READY</span>
                        </div>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 32
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fc_workflow_api.is_gate_approved(nvl(to_number(:P3_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)), 1)
        }
    )

    region handover-report (
        name: Team handover tasks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select handover_id,
                       target_team,
                       initcap(replace(item_type, '_', ' ')) as item_type,
                       title || case when is_assumption = 'Y' then ' (assumption: confirm)' end as title,
                       description,
                       priority,
                       case status
                         when 'COMPLETED' then '<span class="t-Badge t-Badge--success t-Badge--large">COMPLETED</span>'
                         when 'DISPATCHED' then '<span class="t-Badge t-Badge--info t-Badge--large">DISPATCHED</span>'
                         when 'IN_PROGRESS' then '<span class="t-Badge t-Badge--warning">IN PROGRESS</span>'
                         else '<span class="t-Badge t-Badge--subtle">OPEN</span>'
                       end as status_badge,
                       initcap(replace(status, '_', ' ')) as status
                from fc_handover_items
                where tender_id = to_number(coalesce(:P3_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by target_team asc, case priority when 'HIGH' then 1 when 'NORMAL' then 2 else 3 end, handover_id
                ```
        }
        layout {
            sequence: 20
            parentRegion: @planning-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DESCRIPTION (
            derivedColumn: N
            heading {
                heading: Technical Scope & Parameters
            }
            layout {
                sequence: 5
            }
        )

        column HANDOVER_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column ITEM_TYPE (
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 3
            }
        )

        column PRIORITY (
            derivedColumn: N
            heading {
                heading: Priority
            }
            layout {
                sequence: 6
            }
        )

        column STATUS (
            derivedColumn: N
            heading {
                heading: Raw Status
            }
            layout {
                sequence: 8
            }
        )

        column STATUS_BADGE (
            derivedColumn: N
            heading {
                heading: Dispatched Status
            }
            layout {
                sequence: 7
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TARGET_TEAM (
            derivedColumn: N
            heading {
                heading: Target Team
            }
            layout {
                sequence: 2
            }
        )

        column TITLE (
            derivedColumn: N
            heading {
                heading: Deliverable / Task
            }
            layout {
                sequence: 4
            }
        )

    )

    region planning-tabs (
        name: Planning Studio Workbench
        type: staticContent
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--fillLabels
                t-TabsRegion-mod--pill
            ]
        }
    )

    region reprompt-concept-modal (
        name: Edit Concept & Creative Reprompt
        type: staticContent
        layout {
            sequence: 45
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
            ]
            cssClasses: fc-reprompt-modal-panel
        }
        advanced {
            htmlDomId: fc-concept-modal-region
        }
    )

    region tender-selector (
        name: Tender and concept
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_CONCEPT_ID (
        type: selectList
        label {
            label: Concept to select
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @concept-options-lov
            displayExtraValues: false
            nullDisplayValue: -- Choose Winning Hero Concept --
        }
        cascadingLov {
            parentItems: P3_TENDER_ID
        }
        layout {
            sequence: 20
            region: @tender-selector
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_GATE1_COMMENTS (
        type: textarea
        label {
            label: Gate 1 comments
            alignment: left
        }
        layout {
            sequence: 30
            region: @tender-selector
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_LANG_CHOICE (
        type: selectList
        label {
            label: Handover language
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sharedComponent
            lov: @language-mode-lov
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 15
            region: @tender-selector
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: EN
        }
    )

    pageItem P3_TENDER_ID (
        type: selectList
        label {
            label: Tender
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sharedComponent
            lov: @tender-lov
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @tender-selector
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_EDIT_CONCEPT_ID (
        type: hidden
        layout {
            sequence: 1
            region: @reprompt-concept-modal
            slot: regionBody
        }
    )

    pageItem P3_EDIT_OPTION_CODE (
        type: displayOnly
        label {
            label: Editing Concept Option
            alignment: left
        }
        layout {
            sequence: 5
            region: @reprompt-concept-modal
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_REPROMPT_INSTRUCTION (
        type: textarea
        label {
            label: AI Reprompt Instructions
            alignment: left
        }
        layout {
            sequence: 10
            region: @reprompt-concept-modal
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_EDIT_TITLE (
        type: textField
        label {
            label: Concept Title
            alignment: left
        }
        layout {
            sequence: 20
            region: @reprompt-concept-modal
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_EDIT_NARRATIVE (
        type: textarea
        label {
            label: Creative Narrative Framing
            alignment: left
        }
        layout {
            sequence: 30
            region: @reprompt-concept-modal
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_EDIT_SPATIAL (
        type: textarea
        label {
            label: Space & Clearance Guidelines
            alignment: left
        }
        layout {
            sequence: 40
            region: @reprompt-concept-modal
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_EDIT_EVENT_FLOW (
        type: textarea
        label {
            label: Run of Show / Event Flow
            alignment: left
        }
        layout {
            sequence: 50
            region: @reprompt-concept-modal
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button approve-gate1 (
        buttonName: APPROVE_GATE1
        label: Approve Gate 1 and hand over
        layout {
            sequence: 10
            region: @gate1-pending-banner
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            requiresConfirmation: true
        }
        confirmation {
            message: Approve Gate 1 (Planning) and dispatch internal handover collateral?
            style: information
        }
        security {
            authorizationScheme: @planner-role
        }
    )

    button generate-concepts (
        buttonName: GENERATE_CONCEPTS
        label: Generate AI concepts
        layout {
            sequence: 10
            region: @concepts-report
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-magic
        }
        behavior {
            showProcessing: true
        }
    )

    button generate-handover (
        buttonName: GENERATE_HANDOVER
        label: Build handover
        layout {
            sequence: 10
            region: @handover-report
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-list
        }
        behavior {
            showProcessing: true
        }
    )

    button reject-gate1 (
        buttonName: REJECT_GATE1
        label: Reject Gate 1
        layout {
            sequence: 20
            region: @gate1-pending-banner
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            requiresConfirmation: true
        }
        confirmation {
            message: Reject Gate 1 and return to narrative framing?
            style: warning
        }
        security {
            authorizationScheme: @planner-role
        }
    )

    button reprompt-ai-btn (
        buttonName: REPROMPT_AI
        label: Reprompt with AI
        layout {
            sequence: 10
            region: @reprompt-concept-modal
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-magic
        }
        behavior {
            showProcessing: true
        }
    )

    button save-concept-btn (
        buttonName: SAVE_CONCEPT
        label: Save Changes
        layout {
            sequence: 20
            region: @reprompt-concept-modal
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            showProcessing: true
        }
    )

    button close-modal-btn (
        buttonName: CANCEL_EDIT
        label: Close
        layout {
            sequence: 30
            region: @reprompt-concept-modal
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        advanced {
            customAttributes: onclick="closeConceptEditModal(); return false;"
        }
    )

    button select-concept (
        buttonName: SELECT_CONCEPT
        label: Select Winning Concept
        layout {
            sequence: 40
            region: @tender-selector
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check-circle
        }
        security {
            authorizationScheme: @planner-role
        }
    )

    process init-page-tender (
        name: Initialize Page Tender Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P3_TENDER_ID is not null then
                    fc_workflow_api.set_active_project(to_number(:P3_TENDER_ID), :APP_USER);
                else
                    declare
                        l_active_id number := fc_workflow_api.get_active_project(:APP_USER);
                    begin
                        if l_active_id is null then
                            select max(tender_id) into l_active_id from fc_tenders;
                        end if;
                        if l_active_id is not null then
                            :P3_TENDER_ID := to_char(l_active_id);
                            fc_workflow_api.set_active_project(l_active_id, :APP_USER);
                        end if;
                    end;
                end if;
                for t in (select tender_code || ' · ' || client_name as label
                            from fc_tenders
                           where tender_id = fc_workflow_api.get_active_project(:APP_USER)) loop
                    :FC_TENDER_LABEL := t.label;
                end loop;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40957758812652319
        }
    )

