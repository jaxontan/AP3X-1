    process proc-generate-handover (
        name: Call Generate Handover API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                fc_planning_api.generate_handover(
                    p_tender_id => to_number(:P3_TENDER_ID),
                    p_user_name => :APP_USER,
                    p_lang      => nvl(:P3_LANG_CHOICE, 'EN')
                );
                for c in (select count(case when target_team = 'DESIGN' then 1 end) d,
                                 count(case when target_team = 'OPERATIONS' then 1 end) o,
                                 count(case when is_assumption = 'Y' then 1 end) a
                            from fc_handover_items
                           where tender_id = to_number(:P3_TENDER_ID)) loop
                    apex_application.g_print_success_message := 'Handover built: ' || c.d || ' tasks for Design, ' || c.o || ' for Operations'
                        || case when c.a > 0 then ', ' || c.a || ' marked as assumptions to confirm' end || '. Review them, then approve Gate 1.';
                end loop;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 40904587060205853
        }
        serverSideCondition {
            type: request=Value
            value: GENERATE_HANDOVER
        }
    )

