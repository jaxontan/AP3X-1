    pageItem P5_BOQ_ID (
        type: selectList
        label {
            label: BOQ line item
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select component_name || ' (' || initcap(replace(category, '_', ' ')) || ')' d, boq_id v
                  from fc_boq_items
                 where tender_id = :P5_TENDER_ID
                 order by category, boq_id
                ```
            displayExtraValues: false
            nullDisplayValue: - Choose a line item -
        }
        cascadingLov {
            parentItems: P5_TENDER_ID
        }
        layout {
            sequence: 52
            region: @costing-form
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P5_GATE3_COMMENTS (
        type: textarea
        label {
            label: Gate 3 comments
            alignment: left
        }
        layout {
            sequence: 60
            region: @costing-form
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P5_IMAGE_URL (
        type: textField
        label {
            label: Drawing or image link
            alignment: left
        }
        layout {
            sequence: 54
            region: @costing-form
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P5_MARKUP_PCT (
        type: numberField
        label {
            label: Target margin (%)
            alignment: left
        }
        layout {
            sequence: 20
            region: @costing-form
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P5_QUOTE_ID (
        type: selectList
        label {
            label: Vendor quote
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select vendor_name || ' - ' || currency || ' ' || to_char(quoted_amount, 'FM999G999G999G990') || nvl2(lead_time_days, ' - ' || lead_time_days || ' days', null) d, quote_id v
                  from fc_quotations
                 where tender_id = :P5_TENDER_ID
                 order by quoted_amount
                ```
            displayExtraValues: false
            nullDisplayValue: - Choose a quote -
        }
        cascadingLov {
            parentItems: P5_TENDER_ID
        }
        layout {
            sequence: 40
            region: @costing-form
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P5_RFQ_ID (
        type: selectList
