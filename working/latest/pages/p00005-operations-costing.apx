    process init-page-tender (
        name: Initialize Page Tender Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P5_TENDER_ID is null then
                    :P5_TENDER_ID := to_char(fc_workflow_api.get_active_project(:APP_USER));
                    if :P5_TENDER_ID is not null then
                        fc_workflow_api.set_active_project(to_number(:P5_TENDER_ID), :APP_USER);
                    end if;
                else
                    fc_workflow_api.set_active_project(to_number(:P5_TENDER_ID), :APP_USER);
                end if;
                if :P5_MARKUP_PCT is null then
                    select nvl(target_margin_pct, 25) into :P5_MARKUP_PCT from fc_tenders where tender_id = to_number(:P5_TENDER_ID);
                end if;
                for t in (select tender_code || ' · ' || client_name as label
                            from fc_tenders
                           where tender_id = fc_workflow_api.get_active_project(:APP_USER)) loop
                    :FC_TENDER_LABEL := t.label;
                end loop;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40958115118652361
        }
    )

    process proc-approve-gate3 (
        name: Execute Approve Gate 3 API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                fc_costing_api.approve_gate3(
                    p_tender_id => nvl(to_number(:P5_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)),
                    p_user_name => :APP_USER,
                    p_comments => :P5_GATE3_COMMENTS
                );
                apex_application.g_print_success_message := 'Gate 3 Operations Budget Signed Off! Handed off to Multilingual Review.';
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 40918117778205886
