    process proc-load-tender (
        name: Execute Load Selected Tender
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P5_TENDER_ID is not null then
                    fc_workflow_api.set_active_project(to_number(:P5_TENDER_ID), :APP_USER);
                    begin
                        select nvl(margin_pct, 25) into :P5_MARKUP_PCT
                          from fc_tenders
                         where tender_id = to_number(:P5_TENDER_ID);
                    exception
                        when others then null;
                    end;
                    apex_application.g_print_success_message := 'Active tender loaded: #' || :P5_TENDER_ID;
                end if;
                ```
        }
