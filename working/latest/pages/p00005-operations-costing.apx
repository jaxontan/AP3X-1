page 5 (
    name: Operations & Costing Hub
    alias: OPERATIONS-COSTING
    title: Operations Hub - BOQ Calibration & Vendor Quotes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region boq-report (
        name: Bill of quantities
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select boq_id,
                       component_name,
                       initcap(replace(category, '_', ' ')) as category,
                       quantity,
                       uom,
                       unit_cost,
                       initcap(replace(pricing_basis, '_', ' ')) as pricing_basis,
                       margin_pct,
                       markup_pct,
                       total_cost,
                       total_price,
                       spec_details,
                       image_url,
                       extraction_confidence,
                       case when spec_details is not null or image_url is not null then 'BOUND' else 'PENDING' end as spec_bound
                from fc_boq_items
                where tender_id = to_number(coalesce(:P5_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by category asc, boq_id asc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @operations-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 25
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column BOQ_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column CATEGORY (
            derivedColumn: N
            heading {
                heading: Trade / Category
            }
            layout {
                sequence: 3
            }
        )

        column COMPONENT_NAME (
            derivedColumn: N
            heading {
                heading: Item / Component Name
            }
            layout {
                sequence: 2
            }
        )

        column EXTRACTION_CONFIDENCE (
            derivedColumn: N
            heading {
                heading: Confidence
            }
            layout {
                sequence: 13
            }
        )

        column IMAGE_URL (
            derivedColumn: N
            heading {
                heading: Bound Drawing / Image Asset
            }
            layout {
                sequence: 12
            }
        )

        column MARKUP_PCT (
            derivedColumn: N
            heading {
                heading: Markup %
            }
            layout {
                sequence: 8
            }
        )

        column PRICING_BASIS (
            derivedColumn: N
            heading {
                heading: Pricing Source
            }
            layout {
                sequence: 7
            }
        )

        column QUANTITY (
            derivedColumn: N
            heading {
                heading: Qty
            }
            layout {
                sequence: 4
            }
        )

        column SPEC_BOUND (
            derivedColumn: N
            heading {
                heading: Spec Bound
            }
            layout {
                sequence: 14
            }
            columnFormatting {
                htmlExpression: <span class="t-Badge t-Badge--success">#SPEC_BOUND#</span>
            }
        )

        column SPEC_DETAILS (
            derivedColumn: N
            heading {
                heading: Technical Detailing & Specs
            }
            layout {
                sequence: 11
            }
        )

        column TOTAL_COST (
            derivedColumn: N
            heading {
                heading: Total Cost
            }
            layout {
                sequence: 9
            }
        )

        column TOTAL_PRICE (
            derivedColumn: N
            heading {
                heading: Client Price
            }
            layout {
                sequence: 10
            }
        )

        column UNIT_COST (
            derivedColumn: N
            heading {
                heading: Unit Cost (SGD)
            }
            layout {
                sequence: 6
            }
        )

        column UOM (
            derivedColumn: N
            heading {
                heading: UOM
            }
            layout {
                sequence: 5
            }
        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region compliance-findings-report (
        name: Compliance and permits
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select finding_id,
                       initcap(replace(severity, '_', ' ')) as severity,
                       finding_text,
                       required_action,
                       est_compliance_cost,
                       initcap(replace(status, '_', ' ')) as status
                from fc_compliance_findings
                where tender_id = to_number(coalesce(:P5_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by finding_id asc
                ```
        }
        layout {
            sequence: 40
            parentRegion: @operations-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column EST_COMPLIANCE_COST (
            derivedColumn: N
            heading {
                heading: Auto-Injected Fee (SGD)
            }
            layout {
                sequence: 5
            }
        )

        column FINDING_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column FINDING_TEXT (
            derivedColumn: N
            heading {
                heading: Compliance Check
            }
            layout {
                sequence: 3
            }
        )

        column REQUIRED_ACTION (
            derivedColumn: N
            heading {
                heading: Statutory Mitigation
            }
            layout {
                sequence: 4
            }
        )

        column SEVERITY (
            derivedColumn: N
            heading {
                heading: Severity
            }
            layout {
                sequence: 2
            }
        )

        column STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 6
            }
        )

    )

    region costing-buttons (
        name: Step 3 Operations Actions & Budget Gate
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region costing-form (
        name: Costing controls
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region gate3-pending-banner (
        name: Gate 3 Pending Status
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--warning t-Alert--horizontal t-Alert--page">
                    <div class="t-Alert-wrap">
                        <div class="t-Alert-icon">
                            <span class="t-Icon fa fa-clock-o" aria-hidden="true"></span>
                        </div>
                        <div class="t-Alert-content">
                            <h2 class="t-Alert-title">GATE 3 OPERATIONS BUDGET: IN REVIEW (PENDING WEI LIN SIGN-OFF)</h2>
                            <div class="t-Alert-body">Check the bill of quantities, compliance and payment schedule, then click <strong>Approve Gate 3 budget</strong>.</div>
                        </div>
                        <div class="t-Alert-buttons">
                            <span class="t-Badge t-Badge--warning t-Badge--large">PENDING GATE 3</span>
                        </div>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 26
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: not fc_workflow_api.is_gate_approved(nvl(to_number(:P5_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)), 3)
        }
    )

    region gate3-status-banner (
        name: Gate 3 Approved Status
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--success t-Alert--horizontal t-Alert--page">
                    <div class="t-Alert-wrap">
                        <div class="t-Alert-icon">
                            <span class="t-Icon fa fa-check-circle" aria-hidden="true"></span>
                        </div>
                        <div class="t-Alert-content">
                            <h2 class="t-Alert-title">GATE 3 OPERATIONS BUDGET: SIGNED OFF &amp; APPROVED</h2>
                            <div class="t-Alert-body">Granular BOQ verified, PE/LEW statutory fees injected, and client pro-forma invoice generated. Dispatched to Copy &amp; Localisation.</div>
                        </div>
                        <div class="t-Alert-buttons">
                            <span class="t-Badge t-Badge--success t-Badge--large">STAGE 4: COPY REVIEW READY</span>
                        </div>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fc_workflow_api.is_gate_approved(nvl(to_number(:P5_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER)), 3)
        }
    )

    region invoices-report (
        name: Payment schedule
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select invoice_id,
                       invoice_number,
                       initcap(replace(invoice_type, '_', ' ')) as invoice_type,
                       currency,
                       subtotal_amount,
                       gst_rate_pct,
                       gst_amount,
                       total_amount,
                       payment_terms,
                       initcap(replace(payment_status, '_', ' ')) as payment_status,
                       client_contact,
                       due_date
                from fc_invoices
                where tender_id = to_number(coalesce(:P5_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by invoice_id desc
                ```
        }
        layout {
            sequence: 50
            parentRegion: @operations-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CLIENT_CONTACT (
            derivedColumn: N
            heading {
                heading: Client Contact
            }
            layout {
                sequence: 11
            }
        )

        column CURRENCY (
            derivedColumn: N
            heading {
                heading: Currency
            }
            layout {
                sequence: 4
            }
        )

        column DUE_DATE (
            derivedColumn: N
            heading {
                heading: Payment Due Date
            }
            layout {
                sequence: 12
            }
        )

        column GST_AMOUNT (
            derivedColumn: N
            heading {
                heading: GST (9%)
            }
            layout {
                sequence: 7
            }
        )

        column GST_RATE_PCT (
            derivedColumn: N
            heading {
                heading: GST %
            }
            layout {
                sequence: 6
            }
        )

        column INVOICE_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column INVOICE_NUMBER (
            derivedColumn: N
            heading {
                heading: Invoice #
            }
            layout {
                sequence: 2
            }
        )

        column INVOICE_TYPE (
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 3
            }
        )

        column PAYMENT_STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 10
            }
        )

        column PAYMENT_TERMS (
            derivedColumn: N
            heading {
                heading: Payment Terms
            }
            layout {
                sequence: 9
            }
        )

        column SUBTOTAL_AMOUNT (
            derivedColumn: N
            heading {
                heading: Subtotal
            }
            layout {
                sequence: 5
            }
        )

        column TOTAL_AMOUNT (
            derivedColumn: N
            heading {
                heading: Total Amount (SGD)
            }
            layout {
                sequence: 8
            }
        )

    )

    region margin-warning-banner (
        name: Commercial Margin Warning Banner
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--danger t-Alert--horizontal t-Alert--page">
                    <div class="t-Alert-wrap">
                        <div class="t-Alert-icon">
                            <span class="t-Icon fa fa-exclamation-circle" aria-hidden="true"></span>
                        </div>
                        <div class="t-Alert-content">
                            <h2 class="t-Alert-title">COMMERCIAL MARGIN THRESHOLD WARNING</h2>
                            <div class="t-Alert-body">Calibrated tender margin is below the mandatory corporate 20.0% threshold (Current: &P5_MARKUP_PCT.%). Re-negotiate vendor trade rates or apply statutory overtime surcharge before final commercial release.</div>
                        </div>
                        <div class="t-Alert-buttons">
                            <span class="t-Badge t-Badge--danger t-Badge--large">MARGIN &lt; 20%</span>
                        </div>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 27
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: to_number(nvl(:P5_MARKUP_PCT, '25')) < 20.0
        }
    )

    region operations-handover-report (
        name: Operations brief
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select handover_id,
                       initcap(replace(item_type, '_', ' ')) as item_type,
                       title || case when is_assumption = 'Y' then ' (assumption: confirm)' end as title,
                       description,
                       priority
                from fc_handover_items
                where tender_id = to_number(coalesce(:P5_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                  and target_team = 'OPERATIONS'
                order by case priority when 'HIGH' then 1 when 'NORMAL' then 2 else 3 end, handover_id
                ```
        }
        layout {
            sequence: 5
            parentRegion: @operations-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DESCRIPTION (
            derivedColumn: N
            heading {
                heading: Details
            }
            layout {
                sequence: 4
            }
        )

        column HANDOVER_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column ITEM_TYPE (
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 2
            }
        )

        column PRIORITY (
            derivedColumn: N
            heading {
                heading: Priority
            }
            layout {
                sequence: 5
            }
        )

        column TITLE (
            derivedColumn: N
            heading {
                heading: Task
            }
            layout {
                sequence: 3
            }
        )

    )

    region operations-tabs (
        name: Operations & Procurement Workbench
        type: staticContent
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--fillLabels
                t-TabsRegion-mod--pill
            ]
        }
    )

    region returned-quotations-report (
        name: Vendor quotes received
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.quote_id,
                       q.vendor_name,
                       q.quoted_amount,
                       q.currency,
                       q.valid_until,
                       q.lead_time_days,
                       q.exclusions,
                       q.scope_variance_flag,
                       q.is_selected,
                       q.selection_reason
                from fc_quotations q
                where q.tender_id = to_number(coalesce(:P5_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by q.quoted_amount asc
                ```
        }
        layout {
            sequence: 30
            parentRegion: @operations-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CURRENCY (
            derivedColumn: N
            heading {
                heading: Currency
            }
            layout {
                sequence: 4
            }
        )

        column EXCLUSIONS (
            derivedColumn: N
            heading {
                heading: Exclusions / Caveats
            }
            layout {
                sequence: 7
            }
        )

        column IS_SELECTED (
            derivedColumn: N
            heading {
                heading: Selected
            }
            layout {
                sequence: 9
            }
        )

        column LEAD_TIME_DAYS (
            derivedColumn: N
            heading {
                heading: Lead Time (Days)
            }
            layout {
                sequence: 6
            }
        )

        column QUOTED_AMOUNT (
            derivedColumn: N
            heading {
                heading: Quoted Amount
            }
            layout {
                sequence: 3
            }
        )

        column QUOTE_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column SCOPE_VARIANCE_FLAG (
            derivedColumn: N
            heading {
                heading: Scope Variance
            }
            layout {
                sequence: 8
            }
        )

        column SELECTION_REASON (
            derivedColumn: N
            heading {
                heading: Selection Reason
            }
            layout {
                sequence: 10
            }
        )

        column VALID_UNTIL (
            derivedColumn: N
            heading {
                heading: Valid Until
            }
            layout {
                sequence: 5
            }
        )

        column VENDOR_NAME (
            derivedColumn: N
            heading {
                heading: Vendor Name
            }
            layout {
                sequence: 2
            }
        )

    )

    region rfqs-report (
        name: Vendor quote requests
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rfq_id,
                       rfq_code,
                       vendor_name,
                       vendor_email,
                       spec_version,
                       due_date,
                       initcap(replace(status, '_', ' ')) as status,
                       substr(draft_email_body, 1, 120) || '...' as draft_email_preview
                from fc_rfqs
                where tender_id = to_number(coalesce(:P5_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by rfq_id asc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @operations-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DRAFT_EMAIL_PREVIEW (
            derivedColumn: N
            heading {
                heading: Pre-Drafted Outreach Email Preview
            }
            layout {
                sequence: 8
            }
        )

        column DUE_DATE (
            derivedColumn: N
            heading {
                heading: Quote Deadline
            }
            layout {
                sequence: 6
            }
        )

        column RFQ_CODE (
            derivedColumn: N
            heading {
                heading: RFQ #
            }
            layout {
                sequence: 2
            }
        )

        column RFQ_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column SPEC_VERSION (
            derivedColumn: N
            heading {
                heading: Spec Version
            }
            layout {
                sequence: 5
            }
        )

        column STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 7
            }
        )

        column VENDOR_EMAIL (
            derivedColumn: N
            heading {
                heading: Contact Email
            }
            layout {
