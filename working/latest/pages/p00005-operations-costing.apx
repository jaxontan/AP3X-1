    process proc-select-quote (
        name: Execute Select Quotation API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_quote_id number := to_number(:P5_QUOTE_ID);
                begin
                    if l_quote_id is null then
                        select min(quote_id) into l_quote_id
                        from fc_quotations
                        where tender_id = nvl(to_number(:P5_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                    end if;
                    if l_quote_id is not null then
                        fc_costing_api.select_quotation(
                            p_quote_id => l_quote_id,
                            p_reason => nvl(:P5_SELECT_REASON, 'Awarded based on optimal pricing, compliance, and delivery schedule'),
                            p_user_name => :APP_USER
                        );
                        :P5_QUOTE_ID := to_char(l_quote_id);
                        apex_application.g_print_success_message := 'Vendor Quote #' || l_quote_id || ' awarded successfully! Selected quotation recorded with justification and user (' || :APP_USER || ').';
                    else
                        apex_application.g_print_success_message := 'No quotation available to award.';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 40918014785205886
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: AWARD_QUOTE:SELECT_QUOTE
        }
        security {
            authorizationScheme: @costing-role
        }
    )

    process proc-send-rfq (
        name: Execute Record RFQ Sent API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_rfq_id number := to_number(:P5_RFQ_ID);
                begin
                    if l_rfq_id is null then
                        select min(rfq_id) into l_rfq_id
                        from fc_rfqs
                        where tender_id = nvl(to_number(:P5_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER))
                          and status = 'DRAFT';
                    end if;
                    if l_rfq_id is not null then
                        fc_costing_api.record_rfq_sent(
                            p_rfq_id => l_rfq_id,
                            p_user_name => :APP_USER
                        );
                        :P5_RFQ_ID := to_char(l_rfq_id);
                        apex_application.g_print_success_message := 'RFQ #' || l_rfq_id || ' dispatched to specialist vendor! Status updated to DISPATCHED with timestamp and user (' || :APP_USER || ').';
                    else
                        apex_application.g_print_success_message := 'No pending draft RFQs to dispatch.';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 40917971414205873
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DISPATCH_RFQ:SEND_RFQ
        }
    )

)

