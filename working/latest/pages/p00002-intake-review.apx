        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DOCUMENT_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column DOC_TYPE (
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 3
            }
        )

        column FILE_NAME (
            derivedColumn: N
