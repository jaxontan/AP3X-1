    process run-confirm-intake (
        name: Execute Confirm Intake API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_tid number := nvl(to_number(:P2_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                begin
                    if :P2_TEARDOWN_TIME is not null and l_tid is not null then
                        update fc_intake_fields
                           set confirmed_value = :P2_TEARDOWN_TIME,
                               extracted_value = :P2_TEARDOWN_TIME
                         where tender_id = l_tid
                           and field_label = 'TEARDOWN_CURFEW';
                        if sql%rowcount = 0 then
                            insert into fc_intake_fields (tender_id, field_category, field_label, extracted_value, confirmed_value, source_doc_ref, is_missing, is_contradictory, review_status, reviewed_by)
                            values (l_tid, 'LOGISTICS', 'TEARDOWN_CURFEW', :P2_TEARDOWN_TIME, :P2_TEARDOWN_TIME, 'Michelle Planning Review', 'N', 'N', 'CONFIRMED', :APP_USER);
                        end if;
                    end if;
                
                    fc_planning_api.confirm_intake(
                        p_tender_id => l_tid,
                        p_user_name => :APP_USER
                    );
                    apex_application.g_print_success_message := 'Gate 0 confirmed by ' || initcap(:APP_USER) || '. The brief is locked and planning can start.';
                end;
                ```
        }
        execution {
            sequence: 60
        }
