    process run-ocr-analysis (
        name: Upload and Analyse Brief
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_doc_id    number;
                    l_msg       varchar2(4000);
                    l_tender_id number := nvl(to_number(:P2_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                begin
                    if :P2_BRIEF_FILE is not null then
                        -- Real upload: store the file, extract its text, AI analysis for briefs and addenda.
                        fc_planning_api.ingest_uploaded_brief(
                            p_tender_id      => l_tender_id,
                            p_temp_file_name => :P2_BRIEF_FILE,
                            p_doc_type       => nvl(:P2_DOC_TYPE, 'BRIEF'),
                            p_user_name      => :APP_USER,
                            x_doc_id         => l_doc_id,
                            x_message        => l_msg
                        );
                        apex_application.g_print_success_message := apex_escape.html(l_msg);
                    elsif :P2_SAMPLE_DOC_NAME is not null then
                        -- Library sample documents from the demo data set.
                        fc_planning_api.ingest_and_parse_brief(
                            p_tender_id => l_tender_id,
                            p_file_name => :P2_SAMPLE_DOC_NAME,
                            p_doc_type  => nvl(:P2_DOC_TYPE, 'BRIEF'),
                            p_user_name => :APP_USER,
                            x_doc_id    => l_doc_id
                        );
                        apex_application.g_print_success_message := 'Sample document loaded from the library.';
                    else
                        raise_application_error(-20001, 'Drop a brief file into the upload area first.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 40900890899205852
        }
        serverSideCondition {
            type: request=Value
            value: ANALYZE_BRIEF
        }
    )

    process save-metadata (
        name: Save Metadata & Log Intake
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P2_TENDER_ID is not null then
                    if not fc_security_api.can_access_tender(p_tender_id => to_number(:P2_TENDER_ID), p_username => :APP_USER) then
                        raise_application_error(-20005, 'Tender access denied');
                    end if;
                    declare
                        l_client varchar2(100);
                    begin
                        if :P2_CUSTOMER_CHOICE = 'NEW' and :P2_NEW_CLIENT_NAME is not null then
                            l_client := trim(:P2_NEW_CLIENT_NAME);
                        else
                            l_client := :P2_CLIENT_NAME;
                        end if;
                        update fc_tenders
                           set project_title = nvl(:P2_TITLE, project_title),
                               client_name = nvl(l_client, client_name),
                               total_price = nvl(to_number(:P2_BUDGET_AMOUNT), total_price),
                               margin_pct = nvl(to_number(:P2_TARGET_MARGIN_PCT), margin_pct)
                         where tender_id = to_number(:P2_TENDER_ID);
                
                        if :P2_TEARDOWN_TIME is not null then
                            update fc_intake_fields
                               set confirmed_value = :P2_TEARDOWN_TIME,
                                   extracted_value = :P2_TEARDOWN_TIME
                             where tender_id = to_number(:P2_TENDER_ID)
                               and field_label = 'TEARDOWN_CURFEW';
                            if sql%rowcount = 0 then
                                insert into fc_intake_fields (tender_id, field_category, field_label, extracted_value, confirmed_value, source_doc_ref, is_missing, is_contradictory, review_status, reviewed_by)
                                values (to_number(:P2_TENDER_ID), 'LOGISTICS', 'TEARDOWN_CURFEW', :P2_TEARDOWN_TIME, :P2_TEARDOWN_TIME, 'Michelle Planning Review', 'N', 'N', 'CONFIRMED', :APP_USER);
                            end if;
                        end if;
                    end;
                    fc_audit_api.log_event(
                        p_tender_id => to_number(:P2_TENDER_ID),
                        p_user_name => :APP_USER,
                        p_action => 'TENDER_UPDATED',
                        p_entity => 'TENDER',
                        p_details => :P2_TITLE
                    );
                end if;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 40901111145205852
        }
        serverSideCondition {
            type: request=Value
            value: SAVE_TENDER
        }
    )

