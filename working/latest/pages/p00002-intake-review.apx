    process proc-process-addendum (
        name: Process Tender Addendum API
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_tid number := nvl(to_number(:P2_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER));
                begin
                    fc_planning_api.process_tender_addendum(
                        p_tender_id => l_tid,
                        p_user_name => :APP_USER
                    );
                    apex_application.g_print_success_message := 'Tender Addendum processed successfully! Brief addendum registered, drawings marked SUPERSEDED, and downstream BOQ marked STALE (BR-06 cascade). Handover brief re-issued.';
                end;
                ```
        }
        execution {
            sequence: 70
        }
