page 2 (
    name: Tender Setup & Intake Review
    alias: INTAKE-REVIEW
    title: Tender Setup & AI Document Intake
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            function syncCustomerMode() {
                var c = apex.item('P2_CUSTOMER_CHOICE').getValue();
                if (c === 'NEW') {
                    apex.item('P2_NEW_CLIENT_NAME').show();
                    apex.item('P2_CLIENT_NAME').hide();
                } else {
                    apex.item('P2_CLIENT_NAME').show();
                    apex.item('P2_NEW_CLIENT_NAME').hide();
                }
            }
            $('#P2_CUSTOMER_CHOICE').on('change', syncCustomerMode);
            syncCustomerMode();
            $(document).on('click', '.fc-chip', function(e) {
                e.preventDefault();
                var q = $(this).attr('data-query');
                if (q) {
                    apex.item('P2_RESEARCH_QUERY').setValue(q);
                    apex.item('P2_RESEARCH_QUERY').setFocus();
                }
            });
            $(document).on('change', '.fc-confirm-input', function() {
                var $inp = $(this);
                var fid = $inp.attr('data-id');
                var val = $inp.val();
                apex.server.process('UPDATE_INTAKE_FIELD', {
                    x01: fid,
                    x02: val
                }, {
                    success: function() {
                        apex.message.showPageSuccess('Confirmed value updated.');
                        setTimeout(function() { apex.message.hidePageSuccess(); }, 2000);
                    }
                });
            });
            $(document).on('change', '.fc-status-select', function() {
                var $sel = $(this);
                var fid = $sel.attr('data-id');
                var st = $sel.val();
                apex.server.process('UPDATE_INTAKE_FIELD', {
                    x01: fid,
                    x03: st
                }, {
                    success: function() {
                        apex.message.showPageSuccess('Requirement status updated to ' + st + '.');
                        setTimeout(function() { apex.message.hidePageSuccess(); }, 2000);
                    }
                });
            });
            $(document).on('change', '.fc-finding-status-select', function() {
                var $sel = $(this);
                var fid = $sel.attr('data-id');
                var st = $sel.val();
                apex.server.process('UPDATE_FINDING_STATUS', {
                    x01: fid,
                    x02: st
                }, {
                    success: function() {
                        apex.message.showPageSuccess('Citation #' + fid + ' status updated to ' + st + '.');
                        setTimeout(function() { apex.message.hidePageSuccess(); }, 2000);
                    }
                });
            });
            $(document).on('change', '.fc-mitigation-input', function() {
                var $inp = $(this);
                var fid = $inp.attr('data-id');
                var val = $inp.val();
                apex.server.process('UPDATE_PLANNING_FLAG', {
                    x01: fid,
                    x02: val
                }, {
                    success: function() {
                        apex.message.showPageSuccess('Risk mitigation action saved.');
                        setTimeout(function() { apex.message.hidePageSuccess(); }, 2000);
                    }
                });
            });
            $(document).on('change', '.fc-flag-status-select', function() {
                var $sel = $(this);
                var fid = $sel.attr('data-id');
                var st = $sel.val();
                apex.server.process('UPDATE_PLANNING_FLAG', {
                    x01: fid,
                    x03: st
                }, {
                    success: function() {
                        apex.message.showPageSuccess('Risk status updated to ' + st + '.');
                        setTimeout(function() { apex.message.hidePageSuccess(); }, 2000);
                    }
                });
            });
            ```
    }
    security {
        formAutoComplete: false
    }

    region ai-research-section (
        name: 3. Client research
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P2_TENDER_ID is not null
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region brief-upload-section (
        name: 2. Upload client brief
        type: staticContent
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P2_TENDER_ID is not null
        }
    )

    region event-archives-report (
        name: Past pitches
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select archive_id,
                       event_title,
                       client_name,
                       event_year,
                       venue_name,
                       scale_pax,
                       won_pitch_concept,
                       budget_sgd
                from fc_event_archives a
                where exists (
                    select 1 from fc_tenders t
                    where t.tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                      and lower(a.client_name) like '%' || lower(substr(t.client_name, 1, 4)) || '%'
                )
                order by event_year desc
                ```
        }
        layout {
            sequence: 50
            parentRegion: @intake-intel-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ARCHIVE_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column BUDGET_SGD (
            derivedColumn: N
            heading {
                heading: Budget (SGD)
            }
            layout {
                sequence: 8
            }
        )

        column CLIENT_NAME (
            derivedColumn: N
            heading {
                heading: Client
            }
            layout {
                sequence: 3
            }
        )

        column EVENT_TITLE (
            derivedColumn: N
            heading {
                heading: Historical Event
            }
            layout {
                sequence: 2
            }
        )

        column EVENT_YEAR (
            derivedColumn: N
            heading {
                heading: Year
            }
            layout {
                sequence: 4
            }
        )

        column SCALE_PAX (
            derivedColumn: N
            heading {
                heading: Pax
            }
            layout {
                sequence: 6
            }
        )

        column VENUE_NAME (
            derivedColumn: N
            heading {
                heading: Venue
            }
            layout {
                sequence: 5
            }
        )

        column WON_PITCH_CONCEPT (
            derivedColumn: N
            heading {
                heading: Winning Pitch Concept
            }
            layout {
                sequence: 7
            }
        )

    )

    region findings-report (
        name: Brief requirements
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select field_id,
                       initcap(replace(field_category, '_', ' ')) as field_category,
                       field_label,
                       extracted_value,
                       '<input type="text" class="fc-table-input fc-confirm-input" data-id="' || field_id || '" value="' || apex_escape.html_attribute(coalesce(confirmed_value, extracted_value)) || '" aria-label="Edit confirmed value" />' as confirmed_value,
                       '<select class="fc-table-select fc-status-select" data-id="' || field_id || '" aria-label="Requirement status">
                          <option value="CONFIRMED"' || case when upper(review_status) = 'CONFIRMED' then ' selected' end || '>Confirmed</option>
                          <option value="EDITED"' || case when upper(review_status) = 'EDITED' then ' selected' end || '>Edited</option>
                          <option value="PENDING"' || case when upper(review_status) = 'PENDING' then ' selected' end || '>Pending</option>
                        </select>' as review_status
                from fc_intake_fields
                where tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by field_id asc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @intake-intel-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CONFIRMED_VALUE (
            derivedColumn: N
            heading {
                heading: Confirmed Value
            }
            layout {
                sequence: 5
            }
            security {
                escapeSpecialChars: false
            }
        )

        column EXTRACTED_VALUE (
            derivedColumn: N
            heading {
                heading: AI Extracted Fact
            }
            layout {
                sequence: 4
            }
        )

        column FIELD_CATEGORY (
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 2
            }
        )

        column FIELD_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column FIELD_LABEL (
            derivedColumn: N
            heading {
                heading: Criterion / Label
            }
            layout {
                sequence: 3
            }
        )

        column REVIEW_STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 6
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region gate0-confirmed-banner (
        name: GATE 0 STATUS: CONFIRMED & VERIFIED
        type: staticContent
        source {
            htmlCode:
                ```html
                Intake criteria verified by Michelle (Planning Lead). Brief parameters and statutory venue constraints locked. <span class="t-Badge t-Badge--success t-Badge--large">GATE 0 CONFIRMED</span>
                ```
        }
        layout {
            sequence: 11
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--success
                t-Alert--horizontal
                t-Alert--defaultIcons
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P2_TENDER_ID is not null and fc_workflow_api.is_gate_approved(to_number(:P2_TENDER_ID), 0)
        }
    )

    region gate0-pending-banner (
        name: GATE 0 STATUS: PENDING VERIFICATION
        type: staticContent
        source {
            htmlCode:
                ```html
                Check the brief requirements and planning risks below, then click <strong>Confirm brief (Gate 0)</strong>. <span class="t-Badge t-Badge--warning t-Badge--large">PENDING GATE 0</span>
                ```
        }
        layout {
            sequence: 12
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--warning
                t-Alert--horizontal
                t-Alert--defaultIcons
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P2_TENDER_ID is not null and not fc_workflow_api.is_gate_approved(to_number(:P2_TENDER_ID), 0)
        }
    )

    region intake-intel-tabs (
        name: Tender Dossier & AI Intelligence Hub
        type: staticContent
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--fillLabels
                t-TabsRegion-mod--pill
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P2_TENDER_ID is not null
        }
    )

    region planning-flags-report (
        name: Planning risks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select flag_id,
                       initcap(replace(flag_category, '_', ' ')) as flag_category,
                       case
                         when upper(severity) = 'CRITICAL' then '<span class="t-Badge t-Badge--danger"><span class="fa fa-exclamation-triangle" aria-hidden="true"></span> Critical</span>'
                         when upper(severity) = 'WARNING'  then '<span class="t-Badge t-Badge--warning"><span class="fa fa-exclamation-circle" aria-hidden="true"></span> Warning</span>'
                         when upper(severity) = 'ADVISORY' then '<span class="t-Badge t-Badge--info"><span class="fa fa-info-circle" aria-hidden="true"></span> Advisory</span>'
                         else '<span class="t-Badge t-Badge--subtle">' || initcap(severity) || '</span>'
                       end as severity,
                       title,
                       description,
                       '<input type="text" class="fc-table-input fc-mitigation-input" data-id="' || flag_id || '" value="' || apex_escape.html_attribute(coalesce(recommended_mitigation, '')) || '" placeholder="Enter mitigation action..." aria-label="Edit mitigation action" />' as recommended_mitigation,
                       '<select class="fc-table-select fc-flag-status-select" data-id="' || flag_id || '" aria-label="Risk status">
                          <option value="ACTIVE"' || case when upper(status) = 'ACTIVE' then ' selected' end || '>Active</option>
                          <option value="ACKNOWLEDGED"' || case when upper(status) = 'ACKNOWLEDGED' then ' selected' end || '>Acknowledged</option>
                          <option value="MITIGATED"' || case when upper(status) = 'MITIGATED' then ' selected' end || '>Mitigated</option>
                          <option value="RESOLVED"' || case when upper(status) = 'RESOLVED' then ' selected' end || '>Resolved</option>
                        </select>' as status
                from fc_planning_flags
                where tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by flag_id asc
                ```
        }
        layout {
            sequence: 30
            parentRegion: @intake-intel-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DESCRIPTION (
            derivedColumn: N
            heading {
                heading: Operational Impact
            }
            layout {
                sequence: 5
            }
        )

        column FLAG_CATEGORY (
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 2
            }
        )

        column FLAG_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column RECOMMENDED_MITIGATION (
            derivedColumn: N
            heading {
                heading: Recommended Action
            }
            layout {
                sequence: 6
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SEVERITY (
            derivedColumn: N
            heading {
                heading: Severity
            }
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STATUS (
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 7
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TITLE (
            derivedColumn: N
            heading {
                heading: Planning Flag
            }
            layout {
                sequence: 4
            }
        )

    )

    region research-findings-report (
        name: Research sources
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select finding_id,
                       initcap(replace(topic, '_', ' ')) as topic,
                       claim_text,
                       case
                         when source_url is not null then '<a href="' || apex_escape.html_attribute(source_url) || '" target="_blank" rel="noopener noreferrer" class="t-Badge t-Badge--subtle"><span class="fa fa-external-link" aria-hidden="true"></span> ' || coalesce(publisher, 'Source') || '</a>'
                         else coalesce(publisher, '-')
                       end as source_url,
                       publisher,
                       case
                         when confidence_score >= 90 then '<span class="t-Badge t-Badge--success">' || confidence_score || '% High</span>'
                         when confidence_score >= 70 then '<span class="t-Badge t-Badge--info">' || confidence_score || '% Medium</span>'
                         else '<span class="t-Badge t-Badge--warning">' || confidence_score || '% Low</span>'
                       end as confidence_score,
                       '<select class="fc-table-select fc-finding-status-select" data-id="' || finding_id || '" aria-label="Review status">
                          <option value="APPROVED"' || case when upper(review_status) = 'APPROVED' then ' selected' end || '>Approved</option>
                          <option value="REJECTED"' || case when upper(review_status) = 'REJECTED' then ' selected' end || '>Rejected</option>
                          <option value="PENDING"' || case when upper(review_status) = 'PENDING' then ' selected' end || '>Pending</option>
                        </select>' as review_status
                from fc_research_findings
                where tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by finding_id asc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @intake-intel-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CLAIM_TEXT (
            derivedColumn: N
            heading {
                heading: Verified Fact / Initiative
            }
            layout {
                sequence: 3
            }
        )

        column CONFIDENCE_SCORE (
            derivedColumn: N
            heading {
                heading: Confidence
            }
            layout {
                sequence: 6
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FINDING_ID (
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
        )

        column PUBLISHER (
            derivedColumn: N
            heading {
                heading: Source
            }
            layout {
                sequence: 5
            }
        )

        column REVIEW_STATUS (
            derivedColumn: N
            heading {
                heading: Review Status
            }
            layout {
                sequence: 7
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SOURCE_URL (
            derivedColumn: N
            heading {
                heading: Citation Link
            }
            layout {
                sequence: 4
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TOPIC (
            derivedColumn: N
            heading {
                heading: Research Topic
            }
            layout {
                sequence: 2
            }
        )

    )

    region tender-form (
        name: 1. Tender details
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region uploaded-docs-report (
        name: Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select document_id,
                       file_name,
                       initcap(replace(doc_type, '_', ' ')) as doc_type,
                       version_num,
                       uploaded_by,
                       uploaded_at
                from fc_tender_documents
                where tender_id = to_number(coalesce(:P2_TENDER_ID, to_char(fc_workflow_api.get_active_project(:APP_USER))))
                order by document_id desc
                ```
        }
        layout {
            sequence: 40
            parentRegion: @intake-intel-tabs
            slot: tabs
        }
        appearance {
