    process create-new-tender (
        name: Create New Tender
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_new_id number;
                    l_client varchar2(100);
                begin
                    if :P2_CUSTOMER_CHOICE = 'NEW' then
                        l_client := trim(:P2_NEW_CLIENT_NAME);
                    else
                        l_client := :P2_CLIENT_NAME;
                    end if;
                    if l_client is null or trim(:P2_TITLE) is null then
                        raise_application_error(-20011, 'Enter a project title and a client before creating the tender.');
                    end if;
                
                    fc_planning_api.create_tender(
                        p_client_name    => l_client,
                        p_project_title  => trim(:P2_TITLE),
                        p_office         => nvl(:P2_OFFICE, 'SG'),
                        p_budget_ceiling => nvl(to_number(:P2_BUDGET_AMOUNT), 150000),
                        p_currency       => 'SGD',
                        p_user_name      => :APP_USER,
                        x_tender_id      => l_new_id
                    );
                    :P2_TENDER_ID := to_char(l_new_id);
                    fc_workflow_api.set_active_project(l_new_id, :APP_USER);
                    select tender_code || ' · ' || client_name into :FC_TENDER_LABEL from fc_tenders where tender_id = l_new_id;
                    select project_title, client_name, office, total_price, margin_pct
                      into :P2_TITLE, :P2_CLIENT_NAME, :P2_OFFICE, :P2_BUDGET_AMOUNT, :P2_TARGET_MARGIN_PCT
                      from fc_tenders
                     where tender_id = l_new_id;
                    :P2_CUSTOMER_CHOICE := 'EXISTING';
                    :P2_NEW_CLIENT_NAME := null;
                    :P2_NEW_MODE := null;
                    :P2_TEARDOWN_TIME := '23:00 SGT';
                    apex_application.g_print_success_message := 'Tender ' || :FC_TENDER_LABEL || ' created. Upload the client brief next.';
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 40900759682205852
        }
        serverSideCondition {
            type: request=Value
            value: CREATE_TENDER
        }
    )

    process init-tender-metadata (
        name: Load Selected Tender Metadata
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P2_TENDER_ID is not null then
                    :P2_NEW_MODE := null;
                    fc_workflow_api.set_active_project(to_number(:P2_TENDER_ID), :APP_USER);
                    begin
                        select project_title, client_name, office, total_price, margin_pct
                          into :P2_TITLE, :P2_CLIENT_NAME, :P2_OFFICE, :P2_BUDGET_AMOUNT, :P2_TARGET_MARGIN_PCT
                          from fc_tenders
                         where tender_id = to_number(:P2_TENDER_ID);
                        :P2_CUSTOMER_CHOICE := 'EXISTING';
                        :P2_NEW_CLIENT_NAME := null;
                        begin
                            select confirmed_value into :P2_TEARDOWN_TIME
                              from fc_intake_fields
                             where tender_id = to_number(:P2_TENDER_ID)
                               and field_label = 'TEARDOWN_CURFEW'
                             fetch first 1 rows only;
                        exception
                            when no_data_found then
                                :P2_TEARDOWN_TIME := '23:00 SGT';
                        end;
                    exception
                        when no_data_found then null;
                    end;
                elsif :P2_TENDER_ID is null and nvl(:P2_NEW_MODE, 'N') = 'Y' then
                    :P2_CUSTOMER_CHOICE := nvl(:P2_CUSTOMER_CHOICE, 'NEW');
                    :P2_TEARDOWN_TIME := nvl(:P2_TEARDOWN_TIME, '23:00 SGT');
                    :FC_TENDER_LABEL := 'New tender';
                elsif :P2_TENDER_ID is null then
                    declare
                        l_active_id number := fc_workflow_api.get_active_project(:APP_USER);
                    begin
                        if l_active_id is null then
                            select max(tender_id) into l_active_id from fc_tenders;
                        end if;
                        if l_active_id is not null then
                            :P2_TENDER_ID := to_char(l_active_id);
                            fc_workflow_api.set_active_project(l_active_id, :APP_USER);
                            select project_title, client_name, office, total_price, margin_pct
                              into :P2_TITLE, :P2_CLIENT_NAME, :P2_OFFICE, :P2_BUDGET_AMOUNT, :P2_TARGET_MARGIN_PCT
                              from fc_tenders
                             where tender_id = l_active_id;
                            :P2_CUSTOMER_CHOICE := 'EXISTING';
                            :P2_NEW_CLIENT_NAME := null;
                            begin
                                select confirmed_value into :P2_TEARDOWN_TIME
                                  from fc_intake_fields
                                 where tender_id = l_active_id
                                   and field_label = 'TEARDOWN_CURFEW'
                                 fetch first 1 rows only;
                            exception
                                when no_data_found then
                                    :P2_TEARDOWN_TIME := '23:00 SGT';
                            end;
                        else
                            :P2_CUSTOMER_CHOICE := nvl(:P2_CUSTOMER_CHOICE, 'EXISTING');
                            :P2_TEARDOWN_TIME := '23:00 SGT';
                        end if;
                    exception
                        when no_data_found then null;
                    end;
                end if;
                for t in (select tender_code || ' · ' || client_name as label
                            from fc_tenders
                           where tender_id = coalesce(to_number(:P2_TENDER_ID), fc_workflow_api.get_active_project(:APP_USER))) loop
                    :FC_TENDER_LABEL := t.label;
                end loop;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40954968938591374
        }
    )

    process load-tender-action (
        name: Fetch Selected Tender
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P2_TENDER_ID is not null then
                    fc_workflow_api.set_active_project(to_number(:P2_TENDER_ID), :APP_USER);
                    begin
                        select project_title, client_name, office, total_price, margin_pct
                          into :P2_TITLE, :P2_CLIENT_NAME, :P2_OFFICE, :P2_BUDGET_AMOUNT, :P2_TARGET_MARGIN_PCT
                          from fc_tenders
                         where tender_id = to_number(:P2_TENDER_ID);
                        :P2_CUSTOMER_CHOICE := 'EXISTING';
                        :P2_NEW_CLIENT_NAME := null;
                        begin
                            select confirmed_value into :P2_TEARDOWN_TIME
                              from fc_intake_fields
                             where tender_id = to_number(:P2_TENDER_ID)
                               and field_label = 'TEARDOWN_CURFEW'
                             fetch first 1 rows only;
                        exception
                            when no_data_found then
                                :P2_TEARDOWN_TIME := '23:00 SGT';
                        end;
                    exception
                        when no_data_found then null;
                    end;
                end if;
                ```
        }
        execution {
