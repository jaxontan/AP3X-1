    process update-intake-field (
        name: UPDATE_INTAKE_FIELD
        type: executeCode
        execution {
            sequence: 40
            point: ajaxCallback
        }
        source {
            location: localDatabase
            plsqlCode:
                ```plsql
                declare
                    l_id     number := to_number(apex_application.g_x01);
                    l_val    varchar2(4000) := apex_application.g_x02;
                    l_status varchar2(50) := upper(apex_application.g_x03);
                begin
                    if l_id is not null then
                        if l_val is not null then
                            update fc_intake_fields
                               set confirmed_value = l_val,
                                   review_status   = coalesce(l_status, 'CONFIRMED'),
                                   reviewed_by     = :APP_USER,
                                   reviewed_at     = localtimestamp
                             where field_id = l_id;
                        elsif l_status is not null then
                            update fc_intake_fields
                               set review_status   = l_status,
                                   reviewed_by     = :APP_USER,
                                   reviewed_at     = localtimestamp
                             where field_id = l_id;
                        end if;
                        commit;
                    end if;
                    apex_json.open_object;
                    apex_json.write('status', 'success');
                    apex_json.close_object;
                exception
                    when others then
                        apex_json.open_object;
                        apex_json.write('status', 'error');
                        apex_json.write('message', sqlerrm);
                        apex_json.close_object;
                end;
                ```
        }
        security {
            authorizationScheme: @planner-role
        }
    )

    process update-finding-status (
        name: UPDATE_FINDING_STATUS
        type: executeCode
        execution {
            sequence: 50
            point: ajaxCallback
        }
        source {
            location: localDatabase
            plsqlCode:
                ```plsql
                declare
                    l_finding_id number := to_number(apex_application.g_x01);
                    l_status     varchar2(50) := upper(apex_application.g_x02);
                begin
                    if l_finding_id is not null and l_status in ('APPROVED', 'REJECTED', 'PENDING') then
                        fc_planning_api.review_finding(
                            p_finding_id => l_finding_id,
                            p_status     => l_status,
                            p_user_name  => :APP_USER
                        );
                        commit;
                    end if;
                    apex_json.open_object;
                    apex_json.write('status', 'success');
                    apex_json.close_object;
                exception
                    when others then
                        apex_json.open_object;
                        apex_json.write('status', 'error');
                        apex_json.write('message', sqlerrm);
                        apex_json.close_object;
                end;
                ```
        }
        security {
            authorizationScheme: @planner-role
        }
    )

    process update-planning-flag (
        name: UPDATE_PLANNING_FLAG
        type: executeCode
        execution {
            sequence: 60
            point: ajaxCallback
        }
        source {
            location: localDatabase
            plsqlCode:
                ```plsql
                declare
                    l_id         number := to_number(apex_application.g_x01);
                    l_mitigation varchar2(4000) := apex_application.g_x02;
                    l_status     varchar2(50) := upper(apex_application.g_x03);
                begin
                    if l_id is not null then
                        if l_mitigation is not null then
                            update fc_planning_flags
                               set recommended_mitigation = l_mitigation,
                                   status                 = coalesce(l_status, status, 'ACKNOWLEDGED')
                             where flag_id = l_id;
                        elsif l_status is not null then
                            update fc_planning_flags
                               set status = l_status
                             where flag_id = l_id;
                        end if;
                        commit;
                    end if;
                    apex_json.open_object;
                    apex_json.write('status', 'success');
                    apex_json.close_object;
                exception
                    when others then
                        apex_json.open_object;
                        apex_json.write('status', 'error');
                        apex_json.write('message', sqlerrm);
                        apex_json.close_object;
                end;
                ```
        }
        security {
            authorizationScheme: @planner-role
        }
    )

