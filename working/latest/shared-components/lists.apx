list navigation-bar (
    name: Navigation Bar

    entry language-switch (
        label: 🌐 Bahasa / English
        icon {
            imageIconCssClasses: fa-globe
            altAttribute: Switch Language
        }
        layout {
            sequence: 4
        }
        link {
            target: {
                type: url
                url: javascript:fcToggleLanguage();
            }
        }
        userDefinedAttributes {
            1: fc-lang-btn
        }
    )

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
            altAttribute: User Profile
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry project-context (
        label: Projects & Pipeline
        icon {
            imageIconCssClasses: fa-briefcase
            altAttribute: Agency Projects & Pipeline
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-cog
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 8
            }
        }
        security {
            authorizationScheme: @auditor-role
        }
    )

    entry costing (
        label: Costing & BOQ
        icon {
            imageIconCssClasses: fa-calculator
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry dashboard (
        label: Pipeline Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry design (
        label: Design & Spatial
        icon {
            imageIconCssClasses: fa-cube
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry financial-analytics (
        label: Executive Financials
        icon {
            imageIconCssClasses: fa-line-chart
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 9
            }
        }
    )

    entry intake (
        label: Tender Intake
        icon {
            imageIconCssClasses: fa-briefcase
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry planning (
        label: Planning Studio
        icon {
            imageIconCssClasses: fa-pencil-square-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry release (
        label: Proposal Release
        icon {
            imageIconCssClasses: fa-flag
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry repositories (
        label: Repositories
        icon {
            imageIconCssClasses: fa-database
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 7
            }
        }
    )

)

