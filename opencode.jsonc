{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "apex",

  // Zero-cost defaults. Do not replace these with a paid API model.
  // Other free options: opencode/flint-40b-free, opencode/glm-5.3-flash-free,
  // opencode/mimo-v2.6-flash-free.
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/glm-5.3-flash-free",

  "instructions": ["AGENTS.md"],
  "skills": ["./skills"],

  // Live database access through the SQLcl MCP server. Connections are
  // pre-saved with `conn -save ... -savepwd`; no credentials live here.
  // -R 1 allows SQL and most SQLcl commands but blocks host/OS escapes.
  // The Node wrapper locates Java and SQLcl on Windows, macOS, and Linux.
  "mcp": {
    "timeout": {
      "startup": 60000
    },
    "servers": {
      "oracle-sqlcl": {
        "type": "local",
        "command": ["node", "scripts/sqlcl-mcp.mjs"],
        "environment": {
          "JAVA_TOOL_OPTIONS": "-Djava.awt.headless=true -Dfile.encoding=UTF-8"
        },
        "codemode": false
      }
    }
  },

  // This block uses the OpenCode v1 `permission` schema on purpose. Both
  // supported hosts accept it: v1 reads it directly, and v2.2+ converts it to
  // its ordered `permissions` rules. Do not switch back to `permissions`
  // here; v1 rejects that key with "V2 permissions are not supported".
  //
  // Rules are evaluated in order and the last match wins within each tool.
  "permission": {
    // Routine work is allowed. Narrower rules below add the gates.
    "*": "allow",

    // SQLcl MCP tools are the live-database boundary. Keep this at "ask"
    // unless an unattended session is explicitly intended.
    "oracle-sqlcl_*": "ask",

    // Shell commands: allow routine work, then gate destructive actions.
    "bash": {
      "*": "allow",

      "*Remove-Item*": "ask",
      "rm *": "ask",
      "*rm -rf *": "ask",
      "*git push*": "ask",
      "*git reset --hard*": "ask",
      "*git clean*": "ask",
      "*git checkout --*": "ask",
      "*git restore*": "ask",

      "*apex import*": "ask",
      "*deploy-apex-app*": "ask",
      "*drop *": "ask",
      "*truncate *": "ask",
      "*delete *": "ask",
      "*alter system*": "ask"
    },

    // V2 defaults to allowing paths outside the workspace. Keep the stricter
    // v1 default and ask before crossing that boundary.
    "external_directory": "ask",

    // Keep credentials out of model context. The allow for `.env.example`
    // must come after the deny patterns because the last match wins.
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*cwallet.sso": "deny",
      "*.env.example": "allow"
    }
  },

  "watcher": {
    "ignore": ["tools/**", "node_modules/**", ".git/**"]
  }
}
